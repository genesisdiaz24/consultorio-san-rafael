# Configuración del Servidor
PORT=3000
NODE_ENV=development
SESSION_SECRET=cambiar_por_una_clave_secreta_y_aleatoria_en_produccion

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui
DB_NAME=consultorio_san_rafael

# Configuración de Seguridad y CORS
# Orígenes permitidos separados por comas (ejemplo: https://midominio.com,https://app.midominio.com)
CORS_ORIGIN=http://localhost:3000

# Configuración del Servicio de Correo Electrónico (SMTP para Recuperación de Contraseña y Envío de e-CF)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=notificaciones@sanrafael.com
SMTP_PASS=tu_password_smtp_aqui
SMTP_FROM=notificaciones@sanrafael.com
SMTP_FROM_NAME=Consultorio San Rafael

# Configuración de la Clínica
CLINIC_NAME="Consultorio Médico San Rafael"
CLINIC_PHONE="(809) 555-0199"
CLINIC_ADDRESS="Av. San Rafael #102, Santiago de los Caballeros"

# Integración de Facturación Electrónica IMECF (e-CF DGII vía API de IMECF)
# Plataforma Web (Frontend): https://ecf-platform-frontend-50801509587.us-central1.run.app/
# Documentación Técnica API: https://ecf-platform-frontend-50801509587.us-central1.run.app/docs/api-reference
# Base de la API (Backend):  https://ecf-platform-backend-50801509587.us-central1.run.app
IMECF_API_BASE_URL=https://ecf-platform-backend-50801509587.us-central1.run.app
IMECF_API_KEY=COLOCAR_LA_CLAVE_LOCALMENTE
# (Alias compatible)
ECF_API_BASE_URL=https://ecf-platform-backend-50801509587.us-central1.run.app
ECF_API_KEY=COLOCAR_LA_CLAVE_LOCALMENTE
# Ambiente esperado en IMECF (Configuración > Empresa): TesteCF (Pruebas) | CerteCF (Certificación) | eCF (Producción)
ECF_AMBIENTE=TesteCF
# Mantener en false durante pruebas para bloquear envíos si la cuenta de IMECF estuviera en Producción (eCF)
IMECF_ALLOW_PRODUCTION=false
# Tratamiento fiscal por defecto para servicios médicos: 4 = Exento, 1 = Gravado 18%, 2 = Gravado 16%, 3 = Gravado 0%
ECF_DEFAULT_INDICADOR_FACTURACION=4
# Modo demostración separado (false por defecto)
ECF_SIMULATION_MODE=false
ECF_REQUEST_TIMEOUT_MS=20000

# Integración de Pagos con PayPal (Orders v2 & Webhooks)
# Documentación oficial: https://developer.paypal.com/docs/api/orders/v2/
# IMPORTANTE: PAYPAL_CLIENT_SECRET permanece exclusivamente en el backend; nunca exponer al navegador.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=COLOCAR_PAYPAL_CLIENT_ID_SANDBOX
PAYPAL_CLIENT_SECRET=COLOCAR_PAYPAL_CLIENT_SECRET_SANDBOX
PAYPAL_WEBHOOK_ID=COLOCAR_PAYPAL_WEBHOOK_ID_SANDBOX
# Moneda de cobro en PayPal (PayPal no admite DOP directamente; se convierte de DOP a USD)
PAYPAL_CURRENCY=USD
PAYPAL_DOP_TO_USD_RATE=60.00
PAYPAL_SIMULATION_MODE=false
