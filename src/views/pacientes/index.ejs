<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-people-fill text-teal me-2"></i>Directorio de Pacientes
    </h1>
    <p class="text-muted mb-0">Localización inmediata de fichas clínicas y control anti-duplicados por identificación.</p>
  </div>
  <a href="/pacientes/nuevo" class="btn btn-teal fw-semibold shadow-sm">
    <i class="bi bi-person-plus-fill me-1"></i> Registrar Paciente
  </a>
</div>

<!-- Filtro de Búsqueda Rápida de Pacientes -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <form action="/pacientes" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-9 col-lg-10">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="q" value="<%= q %>" class="form-control border-start-0" placeholder="Buscar paciente por Cédula / Identificación, Nombre, Apellido o Teléfono..." autofocus>
        </div>
      </div>
      <div class="col-6 col-md-3 col-lg-2 d-grid">
        <button type="submit" class="btn btn-teal fw-semibold">
          <i class="bi bi-funnel me-1"></i> Buscar
        </button>
      </div>
    </form>
    <% if (q) { %>
      <div class="mt-2 fs-8 text-muted">
        Resultados para la búsqueda: "<strong><%= q %></strong>" &bull; <a href="/pacientes" class="text-teal text-decoration-none">Limpiar filtro</a>
      </div>
    <% } %>
  </div>
</div>

<!-- Tabla de Pacientes -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Identificación</th>
            <th>Paciente</th>
            <th>Contacto</th>
            <th>ARS / Seguro</th>
            <th>Afiliado #</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (pacientes && pacientes.length > 0) { %>
            <% pacientes.forEach(function(p) { %>
              <tr>
                <td>
                  <span class="badge bg-light text-dark border font-monospace fs-7">
                    <i class="bi bi-card-heading text-teal me-1"></i><%= p.identificacion %>
                  </span>
                </td>
                <td>
                  <a href="/pacientes/<%= p.id %>" class="fw-bold text-dark text-decoration-none hover-teal">
                    <%= p.nombre %> <%= p.apellido %>
                  </a>
                  <div class="fs-8 text-muted">
                    <%= p.genero %> &bull; Nacimiento: <%= formatoFecha(p.fecha_nacimiento) %>
                  </div>
                </td>
                <td>
                  <div><i class="bi bi-telephone text-muted me-1"></i><%= p.telefono %></div>
                  <% if (p.correo) { %>
                    <small class="text-muted"><i class="bi bi-envelope text-muted me-1"></i><%= p.correo %></small>
                  <% } %>
                </td>
                <td>
                  <% if (p.ars_nombre) { %>
                    <span class="badge bg-teal-subtle text-teal fw-semibold">
                      <i class="bi bi-shield-check me-1"></i><%= p.ars_nombre %>
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary">Particular / Sin ARS</span>
                  <% } %>
                </td>
                <td>
                  <small class="text-muted"><%= p.numero_afiliado || 'N/A' %></small>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/pacientes/<%= p.id %>" class="btn btn-outline-teal" title="Ver ficha del paciente">
                      <i class="bi bi-folder2-open me-1"></i>Ficha
                    </a>
                    <a href="/citas/nueva?paciente_id=<%= p.id %>" class="btn btn-outline-primary" title="Agendar cita médica">
                      <i class="bi bi-calendar-plus"></i>
                    </a>
                    <% if (usuarioActual && ['MEDICO', 'ADMINISTRADOR'].includes(usuarioActual.rol)) { %>
                      <a href="/consultas/atender?paciente_id=<%= p.id %>" class="btn btn-outline-success" title="Iniciar consulta médica">
                        <i class="bi bi-stethoscope"></i>
                      </a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-2 text-teal-light"></i>
                <h5 class="fw-bold text-dark">No se encontraron pacientes</h5>
                <p class="mb-3">No hay pacientes registrados con los criterios solicitados.</p>
                <a href="/pacientes/nuevo" class="btn btn-teal btn-sm fw-semibold">
                  <i class="bi bi-person-plus me-1"></i> Registrar Primer Paciente
                </a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

