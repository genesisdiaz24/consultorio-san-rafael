<%- include('partials/header') %>
<div class="text-center py-5">
  <div class="display-1 fw-bold text-danger">500</div>
  <h2 class="h4 fw-bold text-dark mb-3">Error interno en el servidor</h2>
  <p class="text-muted mb-3">Ocurrió un inconveniente al procesar la solicitud en el consultorio.</p>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-light border text-start d-inline-block p-3 font-monospace fs-8 text-danger max-w-600">
      <%= error.message %>
    </div>
  <% } %>
  <div class="mt-4">
    <a href="/" class="btn btn-teal fw-semibold">
      <i class="bi bi-arrow-left me-1"></i> Volver al Inicio
    </a>
  </div>
</div>
<%- include('partials/footer') %>

