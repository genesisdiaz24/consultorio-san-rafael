<%- include('../partials/header') %>

<%
  function fmt(valor, tipo) {
    if (valor === null || valor === undefined || valor === '') return '—';
    switch (tipo) {
      case 'moneda': return formatoMoneda(valor);
      case 'fecha': return formatoFecha(valor);
      case 'fechahora': return formatoFechaHora(valor);
      case 'porcentaje': return (parseFloat(valor) || 0).toLocaleString('es-DO', { maximumFractionDigits: 1 }) + '%';
      case 'numero': {
        const n = parseFloat(valor);
        return Number.isNaN(n) ? String(valor) : n.toLocaleString('es-DO', { maximumFractionDigits: 2 });
      }
      default: return String(valor);
    }
  }

  function colorEstado(valor) {
    const v = String(valor || '').toLowerCase();
    if (/(atendida|activo$|completed|entregado$|aceptado|pagado|entrada)/.test(v)) return 'bg-success';
    if (/(cancelada|inactivo|agotado|vencido|failed|declined|rechazado|error|sin_stock|no_entregado)/.test(v)) return 'bg-danger';
    if (/(programada|pendiente|stock bajo|por vencer|created|pending|approved|proceso|ajuste)/.test(v)) return 'bg-warning text-dark';
    if (/(confirmada|sala|salida)/.test(v)) return 'bg-primary';
    return 'bg-secondary';
  }

  const alinearDerecha = (tipo) => ['numero', 'moneda', 'porcentaje'].includes(tipo);
%>

<!-- Encabezado visible solo al imprimir -->
<div class="d-none d-print-block mb-3 border-bottom pb-2">
  <div class="d-flex justify-content-between">
    <div>
      <strong class="fs-5"><%= clinicName %></strong><br>
      <small><%= clinicAddress %> · Tel: <%= clinicPhone %></small>
    </div>
    <div class="text-end">
      <small>Generado: <%= formatoFechaHora(generadoEn) %></small><br>
      <small>Por: <%= generadoPor %></small>
    </div>
  </div>
</div>

<nav aria-label="breadcrumb" class="d-print-none">
  <ol class="breadcrumb fs-7 mb-2">
    <li class="breadcrumb-item"><a href="/reportes" class="text-teal">Reportes</a></li>
    <li class="breadcrumb-item text-muted"><%= modulo.nombre %></li>
  </ol>
</nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi <%= reporte.icono %> text-<%= modulo.color %> me-2"></i><%= reporte.titulo %>
    </h1>
    <p class="text-muted mb-0"><%= reporte.descripcion %></p>
    <% if (resumenFiltros) { %>
      <small class="text-secondary"><i class="bi bi-funnel me-1"></i><%= resumenFiltros %></small>
    <% } %>
  </div>
  <div class="d-flex gap-2 d-print-none">
    <a href="<%= urlCsv %>" class="btn btn-outline-success fw-semibold">
      <i class="bi bi-file-earmark-spreadsheet me-1"></i> Excel (CSV)
    </a>
    <button type="button" class="btn btn-teal fw-semibold" onclick="window.print()">
      <i class="bi bi-printer me-1"></i> Imprimir / PDF
    </button>
  </div>
</div>

<% if (filtros.length > 0) { %>
  <form method="GET" action="/reportes/<%= reporte.id %>" class="card border-0 shadow-sm mb-4 d-print-none">
    <div class="card-body row g-3 align-items-end">
      <% filtros.forEach(function(fl) { %>
        <div class="col-6 col-md-3 col-xl-2">
          <label for="f-<%= fl.nombre %>" class="form-label fs-8 text-uppercase fw-semibold text-muted mb-1"><%= fl.etiqueta %></label>
          <% if (fl.tipo === 'select') { %>
            <select id="f-<%= fl.nombre %>" name="<%= fl.nombre %>" class="form-select form-select-sm">
              <option value="">Todos</option>
              <% fl.opciones.forEach(function(o) { %>
                <option value="<%= o.valor %>" <%= o.valor === fl.valor ? 'selected' : '' %>><%= o.etiqueta %></option>
              <% }); %>
            </select>
          <% } else if (fl.tipo === 'fecha') { %>
            <input type="date" id="f-<%= fl.nombre %>" name="<%= fl.nombre %>" value="<%= fl.valor %>" class="form-control form-control-sm">
          <% } else { %>
            <input type="number" min="0" max="9999" id="f-<%= fl.nombre %>" name="<%= fl.nombre %>" value="<%= fl.valor %>" class="form-control form-control-sm">
          <% } %>
        </div>
      <% }); %>
      <div class="col-12 col-md-auto d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-teal fw-semibold"><i class="bi bi-funnel me-1"></i> Aplicar</button>
        <a href="/reportes/<%= reporte.id %>" class="btn btn-sm btn-outline-secondary">Limpiar</a>
      </div>
    </div>
  </form>
<% } %>

<% if (grafico) { %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <h2 class="h6 fw-bold text-dark mb-3"><i class="bi bi-bar-chart-line text-teal me-2"></i><%= grafico.titulo %></h2>
      <% grafico.barras.forEach(function(b) { %>
        <div class="d-flex align-items-center gap-2 mb-2 fs-7">
          <div class="text-truncate text-secondary" style="width: 30%; min-width: 110px;" title="<%= b.etiqueta %>"><%= b.etiqueta %></div>
          <div class="flex-grow-1">
            <div class="progress" style="height: 18px;" role="img" aria-label="<%= b.etiqueta %>: <%= fmt(b.valor, grafico.tipo) %>">
              <div class="progress-bar bg-teal" style="width: <%= b.ancho %>%;"></div>
            </div>
          </div>
          <div class="fw-semibold text-dark text-end" style="min-width: 90px;"><%= fmt(b.valor, grafico.tipo) %></div>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
    <span class="fw-semibold text-dark"><%= filas.length %> <%= filas.length === 1 ? 'registro' : 'registros' %></span>
    <% if (truncado) { %>
      <small class="text-warning">Se muestran los primeros <%= filas.length %>; el CSV incluye todos.</small>
    <% } %>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-sm align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <% reporte.columnas.forEach(function(c) { %>
              <th class="<%= alinearDerecha(c.tipo) ? 'text-end' : '' %> px-3"><%= c.etiqueta %></th>
            <% }); %>
          </tr>
        </thead>
        <tbody class="fs-7">
          <% if (filas.length === 0) { %>
            <tr>
              <td colspan="<%= reporte.columnas.length %>" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-teal-light"></i>
                No hay datos para los filtros seleccionados.
              </td>
            </tr>
          <% } %>
          <% filas.forEach(function(fila) { %>
            <tr>
              <% reporte.columnas.forEach(function(c) { %>
                <td class="px-3 <%= alinearDerecha(c.tipo) ? 'text-end font-monospace' : '' %>">
                  <% if (c.tipo === 'estado' && fila[c.clave]) { %>
                    <span class="badge <%= colorEstado(fila[c.clave]) %>"><%= fila[c.clave] %></span>
                  <% } else { %>
                    <%= fmt(fila[c.clave], c.tipo) %>
                  <% } %>
                </td>
              <% }); %>
            </tr>
          <% }); %>
        </tbody>
        <% if (totales && filas.length > 0) { %>
          <tfoot class="table-light fw-bold fs-7">
            <tr>
              <% reporte.columnas.forEach(function(c, i) { %>
                <td class="px-3 <%= alinearDerecha(c.tipo) ? 'text-end font-monospace' : '' %>">
                  <% if (c.clave in totales) { %>
                    <% if (c.total === 'promedio') { %><small class="fw-normal text-muted">Prom. </small><% } %>
                    <%= fmt(totales[c.clave], c.tipo) %>
                  <% } else if (i === 0) { %>
                    TOTAL
                  <% } %>
                </td>
              <% }); %>
            </tr>
          </tfoot>
        <% } %>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
