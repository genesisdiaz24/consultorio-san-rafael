<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-file-earmark-bar-graph text-teal me-2"></i>Centro de Reportes
    </h1>
    <p class="text-muted mb-0">
      <% if (esAdmin) { %>
        <%= totalSistema %> reportes organizados en <%= modulosSistema %> módulos (mínimo 6 por módulo).
      <% } else { %>
        <%= totalReportes %> reportes disponibles para su rol.
      <% } %>
      Cada uno se puede filtrar, imprimir (o guardar en PDF) y exportar a Excel.
    </p>
  </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
  <% modulos.forEach(function(m) { %>
    <span class="badge bg-white text-dark border fw-normal py-2 px-3 fs-7">
      <i class="bi <%= m.icono %> text-<%= m.color %> me-1"></i><%= m.reportes[0].codigo.split('.')[0] %>. <%= m.nombre %>:
      <strong><%= m.reportes.length %></strong>
    </span>
  <% }); %>
</div>

<% if (modulos.length === 0) { %>
  <div class="alert alert-info">Su rol no tiene reportes asignados.</div>
<% } %>

<div class="row g-4">
  <% modulos.forEach(function(m) { %>
    <div class="col-12 col-lg-6 col-xxl-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-0 pt-3 pb-2 d-flex align-items-center justify-content-between">
          <h2 class="h6 fw-bold mb-0 text-dark">
            <i class="bi <%= m.icono %> text-<%= m.color %> me-2"></i><%= m.reportes[0].codigo.split('.')[0] %>. <%= m.nombre %>
          </h2>
          <span class="badge bg-light text-dark border"><%= m.reportes.length %> reportes</span>
        </div>
        <div class="list-group list-group-flush">
          <% m.reportes.forEach(function(r) { %>
            <a href="/reportes/<%= r.id %>" class="list-group-item list-group-item-action d-flex gap-3 align-items-start py-3">
              <i class="bi <%= r.icono %> fs-5 text-<%= m.color %> mt-1"></i>
              <span>
                <span class="fw-semibold text-dark d-block"><span class="text-muted fw-normal me-1"><%= r.codigo %></span><%= r.titulo %></span>
                <small class="text-muted"><%= r.descripcion %></small>
              </span>
            </a>
          <% }); %>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../partials/footer') %>
