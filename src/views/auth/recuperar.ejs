<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= typeof title !== 'undefined' ? title : 'Recuperar Contraseña - Consultorio Médico San Rafael' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light auth-page d-flex flex-column justify-content-center align-items-center min-vh-100 py-4 px-2">

<main class="container my-auto">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
      
      <!-- Logo y Encabezado del Consultorio -->
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-teal text-white rounded-circle shadow-sm mb-3 auth-logo-circle">
          <i class="bi bi-hospital fs-1"></i>
        </div>
        <h2 class="h4 fw-bold text-dark mb-1"><%= clinicName %></h2>
        <p class="text-secondary fs-7 mb-0">Sistema Integral de Gestión Clínica &bull; Recuperación Segura</p>
      </div>

      <!-- Tarjeta de Recuperación -->
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-teal text-white py-3 px-4 border-0">
          <h5 class="fw-bold mb-0 fs-6">
            <i class="bi bi-key-fill me-2"></i>Recuperación de Contraseña
          </h5>
          <small class="text-teal-light">Ingrese su usuario o correo institucional registrado.</small>
        </div>

        <div class="card-body p-3 p-sm-4">
          <%- include('../partials/alerts') %>

          <p class="fs-7 text-secondary mb-3">
            Le enviaremos un enlace de recuperación seguro con vigencia de <strong>15 minutos</strong> para restablecer su contraseña de acceso.
          </p>

          <form action="/recuperar-contrasena" method="POST" class="needs-validation" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-4">
              <label for="identificador" class="form-label fs-7 fw-semibold text-dark">Usuario o Correo Registrado</label>
              <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                <input type="text" name="identificador" id="identificador" class="form-control border-start-0" placeholder="Ej: medico o usuario@sanrafael.com" required autofocus>
                <div class="invalid-feedback">Por favor ingrese su usuario o correo registrado.</div>
              </div>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-teal fw-bold py-2 shadow-sm">
                <i class="bi bi-send me-1"></i> Enviar Enlace de Recuperación
              </button>
              <a href="/login" class="btn btn-outline-secondary py-2">
                <i class="bi bi-arrow-left me-1"></i> Volver al Inicio de Sesión
              </a>
            </div>
          </form>
        </div>
      </div>

      <div class="text-center mt-3 text-muted fs-8">
        <%= clinicAddress %> &bull; Tel: <%= clinicPhone %>
      </div>

    </div>
  </div>
</main>

<!-- Bootstrap Bundle JS & App JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>

