<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= typeof title !== 'undefined' ? title : 'Restablecer Contraseña - Consultorio Médico San Rafael' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light auth-page d-flex flex-column justify-content-center align-items-center min-vh-100 py-4 px-2">

<main class="container my-auto">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
      
      <!-- Logo y Encabezado del Consultorio -->
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-teal text-white rounded-circle shadow-sm mb-3 auth-logo-circle">
          <i class="bi bi-hospital fs-1"></i>
        </div>
        <h2 class="h4 fw-bold text-dark mb-1"><%= clinicName %></h2>
        <p class="text-secondary fs-7 mb-0">Sistema Integral de Gestión Clínica &bull; Nueva Contraseña</p>
      </div>

      <!-- Tarjeta de Restablecimiento -->
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-teal text-white py-3 px-4 border-0">
          <h5 class="fw-bold mb-0 fs-6">
            <i class="bi bi-shield-check me-2"></i>Crear Nueva Contraseña
          </h5>
          <small class="text-teal-light">Cuenta: <strong><%= usuario.nombre %></strong> (<%= usuario.usuario %>)</small>
        </div>

        <div class="card-body p-3 p-sm-4">
          <%- include('../partials/alerts') %>

          <form action="/restablecer-contrasena/<%= token %>" method="POST" class="needs-validation" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <label for="contrasena" class="form-label fs-7 fw-semibold text-dark">Nueva Contraseña</label>
              <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-lock"></i></span>
                <input type="password" name="contrasena" id="contrasena" class="form-control border-start-0 border-end-0" placeholder="Mínimo 6 caracteres" minlength="6" required autofocus>
                <button type="button" class="input-group-text bg-white text-muted border-start-0 btn-toggle-password" data-target="contrasena" aria-label="Mostrar u ocultar contraseña">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>

            <div class="mb-4">
              <label for="confirmar_contrasena" class="form-label fs-7 fw-semibold text-dark">Confirmar Nueva Contraseña</label>
              <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-lock-fill"></i></span>
                <input type="password" name="confirmar_contrasena" id="confirmar_contrasena" class="form-control border-start-0 border-end-0" placeholder="Repita la nueva contraseña" minlength="6" required>
                <button type="button" class="input-group-text bg-white text-muted border-start-0 btn-toggle-password" data-target="confirmar_contrasena" aria-label="Mostrar u ocultar contraseña">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>

            <div class="alert alert-secondary border-0 fs-8 text-secondary mb-4 p-2">
              <i class="bi bi-info-circle me-1"></i> Por seguridad, al cambiar la contraseña se cerrarán automáticamente todas las sesiones abiertas en otros dispositivos.
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-teal fw-bold py-2 shadow-sm">
                <i class="bi bi-check2-circle me-1"></i> Guardar Nueva Contraseña
              </button>
              <a href="/login" class="btn btn-outline-secondary py-2">
                <i class="bi bi-x-circle me-1"></i> Cancelar
              </a>
            </div>
          </form>
        </div>
      </div>

      <div class="text-center mt-3 text-muted fs-8">
        <%= clinicAddress %> &bull; Tel: <%= clinicPhone %>
      </div>

    </div>
  </div>
</main>

<!-- Bootstrap Bundle JS & App JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>

