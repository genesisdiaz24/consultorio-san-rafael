<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= typeof title !== 'undefined' ? title : 'Iniciar Sesión - Consultorio Médico San Rafael' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light auth-page d-flex flex-column justify-content-center align-items-center min-vh-100 py-4 px-2">

<main class="container my-auto">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
      
      <!-- Logo y Encabezado del Consultorio -->
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-teal text-white rounded-circle shadow-sm mb-3 auth-logo-circle">
          <i class="bi bi-hospital fs-1"></i>
        </div>
        <h1 class="h4 fw-bold text-dark mb-1"><%= clinicName %></h1>
        <p class="text-secondary fs-7 mb-0">Sistema Integral de Gestión Clínica &bull; Acceso Autorizado</p>
      </div>

      <!-- Tarjeta de Inicio de Sesión -->
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-teal text-white py-3 px-4 border-0">
          <h2 class="fw-bold mb-0 fs-6">
            <i class="bi bi-shield-lock-fill me-2"></i>Inicio de Sesión Obligatorio
          </h2>
          <small class="text-teal-light">Ingrese sus credenciales de usuario para acceder al sistema.</small>
        </div>

        <div class="card-body p-3 p-sm-4">
          <%- include('../partials/alerts') %>

          <form action="/login" method="POST" class="needs-validation" novalidate autocomplete="on">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <label for="usuario" class="form-label fs-7 fw-semibold text-dark">Usuario o Correo Institucional</label>
              <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person"></i></span>
                <input type="text" name="usuario" id="usuario" class="form-control border-start-0" placeholder="Usuario o correo registrado" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
                <div class="invalid-feedback">Por favor ingrese su usuario o correo institucional.</div>
              </div>
            </div>

            <div class="mb-3">
              <label for="contrasena" class="form-label fs-7 fw-semibold text-dark">Contraseña</label>
              <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-key"></i></span>
                <input type="password" name="contrasena" id="contrasena" class="form-control border-start-0 border-end-0" placeholder="••••••••" autocomplete="current-password" required>
                <button type="button" class="input-group-text bg-white text-muted border-start-0 btn-toggle-password" data-target="contrasena" aria-label="Mostrar u ocultar contraseña" title="Mostrar u ocultar contraseña">
                  <i class="bi bi-eye"></i>
                </button>
                <div class="invalid-feedback">Por favor ingrese su contraseña.</div>
              </div>
            </div>

            <div class="d-flex justify-content-end mb-4">
              <a href="/recuperar-contrasena" class="fs-7 text-decoration-none text-teal fw-semibold">
                <i class="bi bi-question-circle me-1"></i>¿Olvidaste tu contraseña?
              </a>
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-teal fw-bold py-2 shadow-sm">
                <i class="bi bi-box-arrow-in-right me-1"></i> Entrar al Sistema
              </button>
            </div>
          </form>
        </div>
      </div>

      <div class="text-center mt-3 text-muted fs-8">
        <%= clinicAddress %> &bull; Tel: <%= clinicPhone %>
      </div>

    </div>
  </div>
</main>

<!-- Bootstrap Bundle JS & App JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
