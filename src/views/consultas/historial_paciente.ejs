<%- include('../partials/header') %>

<%
  const edad = calcularEdad(paciente.fecha_nacimiento);
  const conAlergias = tieneAlergias(paciente.antecedentes_alergicos);
%>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-file-earmark-person-fill text-teal me-2"></i>Historial Clínico: <%= paciente.nombre %> <%= paciente.apellido %>
    </h1>
    <p class="text-muted mb-0">
      Identificación: <strong><%= paciente.identificacion %></strong> &bull; Género: <%= paciente.genero %>
      &bull; Nacimiento: <%= formatoFecha(paciente.fecha_nacimiento) %><% if (edad !== null) { %> &middot; <strong><%= edad %> <%= edad === 1 ? 'año' : 'años' %></strong><% } %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <a href="/consultas/atender?paciente_id=<%= paciente.id %>" class="btn btn-teal fw-semibold shadow-sm">
      <i class="bi bi-stethoscope me-1"></i> Iniciar Nueva Consulta
    </a>
    <a href="/consultas/historial" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver a Historiales
    </a>
  </div>
</div>

<!-- Datos clínicos del expediente -->
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body py-2 px-3">
    <div class="row g-2 fs-7">
      <div class="col-12 col-md-3">
        <span class="text-muted text-uppercase fs-8 fw-semibold d-block">Tipo de sangre</span>
        <% if (paciente.tipo_sangre) { %>
          <span class="fw-bold text-dark"><i class="bi bi-droplet-fill text-danger me-1"></i><%= paciente.tipo_sangre %></span>
        <% } else { %>
          <span class="text-muted fst-italic">No registrado</span>
        <% } %>
      </div>
      <div class="col-12 col-md-3">
        <span class="text-muted text-uppercase fs-8 fw-semibold d-block">Seguro médico (ARS)</span>
        <% if (paciente.ars_nombre) { %>
          <span class="fw-bold text-dark"><i class="bi bi-shield-check text-teal me-1"></i><%= paciente.ars_nombre %></span>
          <% if (paciente.numero_afiliado) { %><small class="text-muted font-monospace ms-1"><%= paciente.numero_afiliado %></small><% } %>
        <% } else { %>
          <span class="text-muted fst-italic">No registrado</span>
        <% } %>
      </div>
      <div class="col-12 col-md-6">
        <span class="text-muted text-uppercase fs-8 fw-semibold d-block">Medicamentos de uso actual</span>
        <% if (paciente.medicamentos_actuales) { %>
          <span class="fw-semibold text-dark"><i class="bi bi-capsule text-primary me-1"></i><%= paciente.medicamentos_actuales %></span>
        <% } else { %>
          <span class="text-muted fst-italic">No registrado</span>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Antecedentes Clínicos Destacados -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <% if (conAlergias) { %>
      <div class="p-3 rounded-3 bg-danger-subtle border border-danger h-100">
        <h6 class="fw-bold text-danger mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Alergias Conocidas</h6>
        <div class="fs-7 fw-bold text-dark"><%= paciente.antecedentes_alergicos %></div>
      </div>
    <% } else { %>
      <div class="p-3 rounded-3 bg-light border h-100">
        <h6 class="fw-bold text-secondary mb-1"><i class="bi bi-shield-check me-1"></i>Alergias Conocidas</h6>
        <div class="fs-7 text-dark">Ninguna conocida</div>
      </div>
    <% } %>
  </div>
  <div class="col-12 col-md-4">
    <div class="p-3 rounded-3 bg-light border h-100">
      <h6 class="fw-bold text-secondary mb-1"><i class="bi bi-heart-pulse me-1"></i>Antecedentes Personales</h6>
      <div class="fs-7 text-dark">
        <%= paciente.antecedentes_personales || 'Sin antecedentes personales reportados' %>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="p-3 rounded-3 bg-light border h-100">
      <h6 class="fw-bold text-secondary mb-1"><i class="bi bi-people me-1"></i>Antecedentes Familiares</h6>
      <div class="fs-7 text-dark">
        <%= paciente.antecedentes_familiares || 'Sin antecedentes familiares reportados' %>
      </div>
    </div>
  </div>
</div>

<!-- Consultas y recetas en una sola tabla -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white py-3 border-0">
    <h5 class="fw-bold mb-0 text-dark">
      <i class="bi bi-clock-history text-teal me-2"></i>Consultas Médicas (<%= consultas.length %>)
    </h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th class="text-nowrap">Fecha</th>
            <th>Servicio</th>
            <th>Diagnóstico</th>
            <th>Plan de Tratamiento</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (consultas && consultas.length > 0) { %>
            <% consultas.forEach(function(c) { %>
              <tr>
                <td class="fw-bold text-teal text-nowrap"><%= formatoFecha(c.fecha_consulta) %></td>
                <td><span class="badge bg-light text-dark border"><%= c.servicio_nombre || 'Consulta General' %></span></td>
                <td><strong class="text-dark"><%= c.diagnostico_clinico %></strong></td>
                <td><p class="text-muted fs-7 mb-0 text-truncate" style="max-width: 300px;" title="<%= c.tratamiento_plan %>"><%= c.tratamiento_plan %></p></td>
                <td class="text-end text-nowrap">
                  <a href="/consultas/<%= c.id %>" class="btn btn-sm btn-outline-teal">
                    <i class="bi bi-eye me-1"></i>Ver detalle
                  </a>
                  <% if (c.receta_id) { %>
                    <a href="/consultas/recetas/<%= c.receta_id %>" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-prescription me-1"></i>Ver receta
                    </a>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">
                No hay consultas previas registradas para este paciente.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
