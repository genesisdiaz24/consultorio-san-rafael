<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-file-earmark-person-fill text-teal me-2"></i>Historial Clínico: <%= paciente.nombre %> <%= paciente.apellido %>
    </h1>
    <p class="text-muted mb-0">Identificación: <strong><%= paciente.identificacion %></strong> &bull; Género: <%= paciente.genero %> &bull; Nacimiento: <%= formatoFecha(paciente.fecha_nacimiento) %></p>
  </div>
  <div class="d-flex gap-2">
    <a href="/consultas/atender?paciente_id=<%= paciente.id %>" class="btn btn-teal fw-semibold shadow-sm">
      <i class="bi bi-stethoscope me-1"></i> Iniciar Nueva Consulta
    </a>
    <a href="/consultas/historial" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver a Historiales
    </a>
  </div>
</div>

<!-- Antecedentes Clínicos Destacados -->
<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <div class="p-3 rounded-3 bg-danger-subtle border border-danger h-100">
      <h6 class="fw-bold text-danger mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Alergias Conocidas</h6>
      <div class="fs-7 <%= paciente.antecedentes_alergicos ? 'fw-bold text-dark' : 'text-muted fst-italic' %>">
        <%= paciente.antecedentes_alergicos || 'Sin antecedentes alérgicos reportados' %>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="p-3 rounded-3 bg-light border h-100">
      <h6 class="fw-bold text-secondary mb-1"><i class="bi bi-heart-pulse me-1"></i>Antecedentes Personales</h6>
      <div class="fs-7 text-dark">
        <%= paciente.antecedentes_personales || 'Sin antecedentes personales reportados' %>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="p-3 rounded-3 bg-light border h-100">
      <h6 class="fw-bold text-secondary mb-1"><i class="bi bi-people me-1"></i>Antecedentes Familiares</h6>
      <div class="fs-7 text-dark">
        <%= paciente.antecedentes_familiares || 'Sin antecedentes familiares reportados' %>
      </div>
    </div>
  </div>
</div>

<!-- Consultas Médicas Previas -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white py-3 border-0">
    <h5 class="fw-bold mb-0 text-dark">
      <i class="bi bi-clock-history text-teal me-2"></i>Evolución y Atenciones Médicas Anteriores (<%= consultas.length %>)
    </h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Fecha</th>
            <th>Servicio</th>
            <th>Diagnóstico Clínico</th>
            <th>Plan de Tratamiento</th>
            <th class="text-end">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% if (consultas && consultas.length > 0) { %>
            <% consultas.forEach(function(c) { %>
              <tr>
                <td class="fw-bold text-teal"><%= formatoFecha(c.fecha_consulta) %></td>
                <td><span class="badge bg-light text-dark border"><%= c.servicio_nombre || 'Consulta General' %></span></td>
                <td><strong class="text-dark"><%= c.diagnostico_clinico %></strong></td>
                <td><p class="text-muted fs-7 mb-0 text-truncate" style="max-width: 300px;"><%= c.tratamiento_plan %></p></td>
                <td class="text-end">
                  <a href="/consultas/<%= c.id %>" class="btn btn-sm btn-outline-teal">
                    <i class="bi bi-eye me-1"></i> Ver Detalle
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">
                No hay consultas previas registradas para este paciente.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Recetas Médicas Emitidas al Paciente -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white py-3 border-0">
    <h5 class="fw-bold mb-0 text-dark">
      <i class="bi bi-capsule text-teal me-2"></i>Recetas Médicas Prescritas (<%= recetas.length %>)
    </h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Código Receta</th>
            <th>Fecha de Emisión</th>
            <th>Diagnóstico Asociado</th>
            <th>Indicaciones Generales</th>
            <th class="text-end">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% if (recetas && recetas.length > 0) { %>
            <% recetas.forEach(function(r) { %>
              <tr>
                <td class="fw-bold font-monospace text-teal"><%= r.codigo_receta %></td>
                <td><%= formatoFecha(r.fecha_emision) %></td>
                <td><strong><%= r.diagnostico_clinico %></strong></td>
                <td class="text-muted fs-7"><%= r.indicaciones_generales || 'Según indicaciones de cada fármaco' %></td>
                <td class="text-end">
                  <a href="/consultas/recetas/<%= r.id %>" class="btn btn-sm btn-outline-teal">
                    <i class="bi bi-printer me-1"></i> Ver / Imprimir
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">
                No se han emitido recetas para este paciente.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

