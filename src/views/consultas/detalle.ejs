<%- include('../partials/header') %>

<!-- Encabezado con Botones de Acción -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 d-print-none">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-file-earmark-medical-fill text-teal me-2"></i>Atención Médica #<%= consulta.id %>
    </h1>
    <p class="text-muted mb-0">
      Fecha: <strong><%= formatoFecha(consulta.fecha_consulta) %></strong> &bull; Paciente: 
      <strong><%= consulta.paciente_nombre %> <%= consulta.paciente_apellido %></strong>
      &bull; Médico: <strong><%= consulta.medico_nombre || 'Sin asignar' %></strong>
    </p>
  </div>
  <div class="d-flex gap-2">
    <button onclick="window.print()" class="btn btn-outline-teal fw-semibold">
      <i class="bi bi-printer me-1"></i> Imprimir Ficha / Receta
    </button>
    <a href="/pacientes/<%= consulta.paciente_id %>" class="btn btn-outline-secondary">
      <i class="bi bi-folder2-open me-1"></i> Ver Ficha del Paciente
    </a>
  </div>
</div>

<% const esPerfilMedico = usuarioActual && usuarioActual.rol === 'MEDICO'; %>

<div class="row g-4">
  <!-- Columna Izquierda: Historia y Hallazgos Clínicos -->
  <div class="col-12 <%= esPerfilMedico ? 'col-lg-12' : 'col-lg-8' %>">
    
    <!-- Datos del Paciente en la Consulta -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <div class="row g-3">
          <div class="col-12 col-sm-6">
            <span class="fs-8 text-secondary text-uppercase fw-semibold d-block">Paciente</span>
            <div class="fs-5 fw-bold text-dark"><%= consulta.paciente_nombre %> <%= consulta.paciente_apellido %></div>
            <div class="text-muted fs-7 font-monospace">Cédula: <%= consulta.paciente_identificacion %></div>
          </div>
          <div class="col-12 col-sm-6 text-sm-end">
            <span class="fs-8 text-secondary text-uppercase fw-semibold d-block">Servicio y Aseguradora</span>
            <div class="fw-bold text-teal"><%= consulta.servicio_nombre || 'Consulta Médica General' %></div>
            <div class="text-muted fs-7">
              <%= consulta.ars_nombre || 'Particular / Sin Aseguradora' %>
              <% if (consulta.paciente_afiliado) { %>
                &bull; Afiliado: <%= consulta.paciente_afiliado %>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Signos Vitales Registrados -->
    <% 
      let signos = {};
      try { 
        signos = typeof consulta.signos_vitales === 'string' ? JSON.parse(consulta.signos_vitales) : (consulta.signos_vitales || {});
      } catch (_) {}
    %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white py-3 border-0">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-activity text-teal me-2"></i>Signos Vitales al Momento de la Consulta</h6>
      </div>
      <div class="card-body p-4 pt-1">
        <div class="row g-2 text-center">
          <div class="col-6 col-sm-4 col-md-2">
            <div class="p-2 rounded bg-light border">
              <span class="fs-8 text-muted d-block">Presión Art.</span>
              <strong class="text-dark fs-7"><%= signos.presion_arterial || 'N/A' %></strong>
            </div>
          </div>
          <div class="col-6 col-sm-4 col-md-2">
            <div class="p-2 rounded bg-light border">
              <span class="fs-8 text-muted d-block">Temperatura</span>
              <strong class="text-dark fs-7"><%= signos.temperatura || 'N/A' %></strong>
            </div>
          </div>
          <div class="col-6 col-sm-4 col-md-2">
            <div class="p-2 rounded bg-light border">
              <span class="fs-8 text-muted d-block">Pulso / F.C.</span>
              <strong class="text-dark fs-7"><%= signos.frecuencia_cardiaca || 'N/A' %></strong>
            </div>
          </div>
          <div class="col-6 col-sm-4 col-md-2">
            <div class="p-2 rounded bg-light border">
              <span class="fs-8 text-muted d-block">Frec. Resp.</span>
              <strong class="text-dark fs-7"><%= signos.frecuencia_respiratoria || 'N/A' %></strong>
            </div>
          </div>
          <div class="col-6 col-sm-4 col-md-2">
            <div class="p-2 rounded bg-light border">
              <span class="fs-8 text-muted d-block">Peso</span>
              <strong class="text-dark fs-7"><%= signos.peso || 'N/A' %></strong>
            </div>
          </div>
          <div class="col-6 col-sm-4 col-md-2">
            <div class="p-2 rounded bg-light border">
              <span class="fs-8 text-muted d-block">Talla</span>
              <strong class="text-dark fs-7"><%= signos.talla || 'N/A' %></strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Registro Clínico: Motivo, Examen, Diagnóstico y Tratamiento -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white py-3 border-0">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-file-text text-teal me-2"></i>Evaluación y Diagnóstico Clínico</h6>
      </div>
      <div class="card-body p-4 pt-1">
        <div class="mb-3">
          <span class="fs-8 text-secondary text-uppercase fw-semibold d-block">Motivo de Consulta</span>
          <p class="text-dark mb-0"><%= consulta.motivo_consulta %></p>
        </div>

        <div class="mb-3">
          <span class="fs-8 text-secondary text-uppercase fw-semibold d-block">Hallazgos Clínicos y Examen Físico</span>
          <p class="text-dark mb-0 whitespace-pre-line"><%= consulta.hallazgos_clinicos %></p>
        </div>

        <div class="p-3 rounded-3 bg-light border-start border-4 border-teal mb-3">
          <span class="fs-8 text-teal text-uppercase fw-bold d-block">Diagnóstico Clínico</span>
          <div class="fs-6 fw-bold text-dark"><%= consulta.diagnostico_clinico %></div>
        </div>

        <div>
          <span class="fs-8 text-secondary text-uppercase fw-semibold d-block">Plan Terapéutico y Conducta Médica</span>
          <p class="text-dark mb-0 whitespace-pre-line"><%= consulta.tratamiento_plan %></p>
        </div>
      </div>
    </div>

    <!-- Receta Médica Emitida (Formato para Impresión y Farmacia) -->
    <% if (receta) { %>
      <div class="card border-0 shadow-sm printable-receta mb-4">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
          <div>
            <span class="badge bg-teal me-2"><i class="bi bi-prescription2 me-1"></i>Rx</span>
            <strong class="text-dark">Receta Médica Oficial &mdash; <%= receta.codigo_receta %></strong>
          </div>
          <span class="fs-8 text-muted">Fecha: <%= formatoFecha(receta.fecha_emision) %></span>
        </div>
        <div class="card-body p-4 pt-1">
          <% if (receta.indicaciones_generales) { %>
            <div class="alert alert-light border py-2 px-3 mb-3 fs-7">
              <strong>Indicaciones Generales:</strong> <%= receta.indicaciones_generales %>
            </div>
          <% } %>

          <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
              <thead class="table-light fs-8 text-uppercase">
                <tr>
                  <th>#</th>
                  <th>Medicamento</th>
                  <th>Dosis</th>
                  <th>Frecuencia</th>
                  <th>Indicaciones de Uso</th>
                  <th class="text-center">Cant.</th>
                  <th class="d-print-none text-center">Estado Farmacia</th>
                </tr>
              </thead>
              <tbody>
                <% if (medicamentos && medicamentos.length > 0) { %>
                  <% medicamentos.forEach(function(m, idx) { %>
                    <tr>
                      <td class="fw-bold text-muted"><%= idx + 1 %></td>
                      <td>
                        <strong class="text-dark"><%= m.nombre_medicamento %></strong>
                      </td>
                      <td><%= m.dosis %></td>
                      <td><%= m.frecuencia %></td>
                      <td class="fs-7 text-secondary"><%= m.indicaciones_uso %></td>
                      <td class="text-center fw-bold"><%= m.cantidad_recetada %></td>
                      <td class="d-print-none text-center">
                        <% if (m.estado_dispensacion === 'Entregado') { %>
                          <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Entregado</span>
                        <% } else if (m.estado_dispensacion === 'No entregado - Sin existencias') { %>
                          <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Sin existencias</span>
                        <% } else { %>
                          <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pendiente</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted">No hay medicamentos en la receta.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Firma del Médico en Impresión -->
          <div class="d-none d-print-block mt-5 pt-4 text-center">
            <div class="d-inline-block border-top border-dark pt-2 px-5">
              <strong><%= consulta.medico_nombre || 'Dr. / Dra. Especialista en Consulta' %></strong><br>
              <span class="fs-8">Consultorio Médico San Rafael &bull; Exequátur Médico</span>
            </div>
          </div>
        </div>
        <div class="card-footer bg-white border-0 py-3 text-end d-print-none">
          <% if (usuarioActual && (usuarioActual.rol === 'FARMACIA' || usuarioActual.rol === 'ADMINISTRADOR')) { %>
            <a href="/farmacia/dispensar/<%= receta.id %>" class="btn btn-teal btn-sm fw-semibold">
              <i class="bi bi-capsule me-1"></i> Gestionar Despacho en Farmacia
            </a>
          <% } else { %>
            <span class="badge bg-light text-secondary border px-3 py-2">
              <i class="bi bi-check2-circle text-teal me-1"></i> Receta registrada &bull; Gestión de existencias en Farmacia
            </span>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>

  <% if (!esPerfilMedico) { %>
    <!-- Columna Derecha: Liquidación de ARS, Cobro y Comprobante Electrónico (e-CF) (Oculto para Médico; exclusivo Administración) -->
    <div class="col-12 col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-0">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-receipt text-teal me-2"></i>Liquidación de Servicio y ARS
          </h6>
        </div>
        <div class="card-body p-4 pt-0">
          <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
              <span class="text-muted">Valor Total Servicio</span>
              <strong class="text-dark"><%= formatoMoneda(consulta.valor_total) %></strong>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 text-teal">
              <span>
                <i class="bi bi-shield-check me-1"></i>Cubierto por ARS
              </span>
              <strong>- <%= formatoMoneda(consulta.valor_cubierto_ars) %></strong>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 bg-light rounded mt-2">
              <div>
                <strong class="text-dark d-block">Copago del Paciente</strong>
                <small class="text-muted fs-8">Diferencia a pagar</small>
              </div>
              <div class="fs-4 fw-bold text-danger">
                <%= formatoMoneda(consulta.diferencia_paciente) %>
              </div>
            </li>
          </ul>

          <div class="mb-3">
            <span class="fs-8 text-secondary text-uppercase fw-semibold d-block">Estado del Pago</span>
            <span class="badge <%= consulta.estado_pago === 'Pagado' ? 'bg-success' : 'bg-warning text-dark' %> fs-7">
              <%= consulta.estado_pago %>
            </span>
          </div>

          <div class="alert alert-light border fs-8 text-secondary p-3 mb-0">
            <i class="bi bi-info-circle text-teal me-1"></i>
            Los valores registrados provienen del tarifario oficial configurado para 
            <strong><%= consulta.ars_nombre || 'Particular' %></strong>.
          </div>
        </div>
      </div>

      <%- include('../partials/ecf_widget', { returnToUrl: '/consultas/' + consulta.id }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>


