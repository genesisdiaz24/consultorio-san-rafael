<%- include('../partials/header') %>

<div class="mb-4">
  <h1 class="h3 fw-bold text-dark mb-1">
    <i class="bi bi-prescription text-teal me-2"></i>Recetas Médicas Prescritas
  </h1>
  <p class="text-muted mb-0">Listado de recetas médicas emitidas durante las consultas clínicas.</p>
</div>

<!-- Filtros: se aplican mientras se escribe -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <div class="row g-2 align-items-end">
      <div class="col-12 col-lg-6">
        <label for="filtro_texto" class="form-label fs-8 text-uppercase fw-semibold text-muted mb-1">Buscar</label>
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
          <input type="search" id="filtro_texto" value="<%= q %>" class="form-control border-start-0" placeholder="Código de receta, paciente, cédula o diagnóstico..." autocomplete="off">
        </div>
      </div>
      <div class="col-6 col-lg-2">
        <label for="filtro_desde" class="form-label fs-8 text-uppercase fw-semibold text-muted mb-1">Desde</label>
        <input type="date" id="filtro_desde" class="form-control">
      </div>
      <div class="col-6 col-lg-2">
        <label for="filtro_hasta" class="form-label fs-8 text-uppercase fw-semibold text-muted mb-1">Hasta</label>
        <input type="date" id="filtro_hasta" class="form-control">
      </div>
      <div class="col-12 col-lg-2 text-lg-end">
        <span class="fs-7 text-muted" id="contador_recetas"><%= recetas.length %> receta(s)</span>
      </div>
    </div>
  </div>
</div>

<!-- Listado de Recetas -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th class="text-nowrap" style="width: 1%;">Código Receta</th>
            <th class="text-nowrap" style="width: 1%;">Fecha</th>
            <th style="min-width: 180px;">Paciente</th>
            <th>Diagnóstico Clínico</th>
            <th class="text-nowrap" style="width: 1%;">Medicamentos</th>
            <th class="text-end text-nowrap" style="width: 1%;">Acciones</th>
          </tr>
        </thead>
        <tbody id="tabla_recetas">
          <% if (recetas && recetas.length > 0) { %>
            <% recetas.forEach(function(r) { %>
              <tr data-fecha="<%= r.fecha_iso %>"
                  data-texto="<%= [r.codigo_receta, r.paciente_nombre, r.paciente_apellido, r.paciente_identificacion, r.diagnostico_clinico].join(' ') %>">
                <td class="fw-bold font-monospace text-teal text-nowrap"><%= r.codigo_receta %></td>
                <td class="text-nowrap"><%= formatoFecha(r.fecha_iso + 'T12:00:00') %></td>
                <td>
                  <div class="fw-bold text-dark"><%= r.paciente_nombre %> <%= r.paciente_apellido %></div>
                  <small class="text-muted font-monospace text-nowrap"><%= r.paciente_identificacion %></small>
                </td>
                <td><strong class="text-dark"><%= r.diagnostico_clinico %></strong></td>
                <td class="text-nowrap">
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-capsule me-1 text-teal"></i><%= r.total_medicamentos %> <%= r.total_medicamentos === 1 ? 'ítem' : 'ítems' %>
                  </span>
                </td>
                <td class="text-end text-nowrap">
                  <a href="/consultas/recetas/<%= r.id %>" class="btn btn-sm btn-outline-teal">
                    <i class="bi bi-printer me-1"></i>Ver / Imprimir
                  </a>
                  <a href="/consultas/<%= r.consulta_id %>" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-journal-medical me-1"></i>Ver consulta
                  </a>
                </td>
              </tr>
            <% }); %>
            <tr id="fila_sin_resultados" class="d-none">
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-search fs-1 d-block mb-2 text-teal-light"></i>
                Ninguna receta coincide con la búsqueda o el rango de fechas.
              </td>
            </tr>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-file-earmark-medical fs-1 d-block mb-2 text-teal-light"></i>
                <h6 class="fw-bold text-dark">No hay recetas emitidas</h6>
                <p class="mb-0">Las recetas generadas en consulta médica aparecerán aquí.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
(function () {
  const texto = document.getElementById('filtro_texto');
  const desde = document.getElementById('filtro_desde');
  const hasta = document.getElementById('filtro_hasta');
  const contador = document.getElementById('contador_recetas');
  const sinResultados = document.getElementById('fila_sin_resultados');
  const filas = Array.from(document.querySelectorAll('#tabla_recetas tr[data-fecha]'));
  // Sin tildes y en minúsculas, para que "maria" encuentre "María"
  const limpiar = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
  filas.forEach((f) => { f.dataset.busqueda = limpiar(f.dataset.texto); });

  function filtrar() {
    const palabras = limpiar(texto.value).split(/\s+/).filter(Boolean);
    const d = desde.value;
    const h = hasta.value;
    let visibles = 0;
    filas.forEach((f) => {
      const coincide = palabras.every((p) => f.dataset.busqueda.includes(p))
        && (!d || f.dataset.fecha >= d)
        && (!h || f.dataset.fecha <= h);
      f.classList.toggle('d-none', !coincide);
      if (coincide) visibles++;
    });
    if (sinResultados) sinResultados.classList.toggle('d-none', visibles > 0 || filas.length === 0);
    contador.textContent = `${visibles} receta(s)`;
  }

  [texto, desde, hasta].forEach((el) => el.addEventListener('input', filtrar));
  filtrar();
})();
</script>

<%- include('../partials/footer') %>
