<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-prescription text-teal me-2"></i>Recetas Médicas Prescritas
    </h1>
    <p class="text-muted mb-0">Listado de recetas médicas emitidas durante las consultas clínicas.</p>
  </div>
  <a href="/citas/sala-espera" class="btn btn-teal fw-semibold shadow-sm">
    <i class="bi bi-stethoscope me-1"></i> Atender Paciente
  </a>
</div>

<!-- Filtro de Búsqueda -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <form action="/consultas/recetas" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-9 col-lg-10">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="q" value="<%= q %>" class="form-control border-start-0" placeholder="Buscar por código de receta, paciente o diagnóstico...">
        </div>
      </div>
      <div class="col-6 col-md-3 col-lg-2 d-grid">
        <button type="submit" class="btn btn-teal fw-semibold">
          <i class="bi bi-funnel me-1"></i> Buscar
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Listado de Recetas -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Código Receta</th>
            <th>Fecha</th>
            <th>Paciente</th>
            <th>Diagnóstico Clínico</th>
            <th>Medicamentos</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (recetas && recetas.length > 0) { %>
            <% recetas.forEach(function(r) { %>
              <tr>
                <td class="fw-bold font-monospace text-teal"><%= r.codigo_receta %></td>
                <td><%= formatoFecha(r.fecha_emision) %></td>
                <td>
                  <div class="fw-bold text-dark"><%= r.paciente_nombre %> <%= r.paciente_apellido %></div>
                  <small class="text-muted font-monospace"><%= r.paciente_identificacion %></small>
                </td>
                <td><strong class="text-dark"><%= r.diagnostico_clinico %></strong></td>
                <td>
                  <span class="badge bg-light text-dark border me-1">
                    <i class="bi bi-capsule me-1 text-teal"></i><%= r.total_medicamentos %> ítem(s)
                  </span>
                  <% const tot = parseInt(r.total_medicamentos, 10) || 0; %>
                  <% const ent = parseInt(r.total_entregados, 10) || 0; %>
                  <% const noEnt = parseInt(r.total_no_entregados, 10) || 0; %>
                  <% if (tot > 0 && ent === tot) { %>
                    <span class="badge bg-success-subtle text-success border border-success">
                      <i class="bi bi-check-all me-1"></i>Completada
                    </span>
                  <% } else if (ent > 0 || noEnt > 0) { %>
                    <span class="badge bg-info-subtle text-info-emphasis border border-info">
                      <i class="bi bi-pie-chart me-1"></i><%= ent %>/<%= tot %> Entregados
                    </span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                      <i class="bi bi-clock me-1"></i>Pendiente farmacia
                    </span>
                  <% } %>
                </td>
                <td class="text-end">
                  <a href="/consultas/recetas/<%= r.id %>" class="btn btn-sm btn-outline-teal">
                    <i class="bi bi-printer me-1"></i> Ver / Imprimir
                  </a>
                  <a href="/consultas/<%= r.consulta_id %>" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-journal-medical me-1"></i> Consulta
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-file-earmark-medical fs-1 d-block mb-2 text-teal-light"></i>
                <h6 class="fw-bold text-dark">No hay recetas emitidas</h6>
                <p class="mb-0">Las recetas generadas en consulta médica aparecerán aquí.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

