<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-journal-medical text-teal me-2"></i>Historiales Clínicos de Pacientes
    </h1>
    <p class="text-muted mb-0">Consulta médica de antecedentes, atenciones previas y evolución de pacientes.</p>
  </div>
  <a href="/citas/sala-espera" class="btn btn-teal fw-semibold shadow-sm">
    <i class="bi bi-bell-fill me-1"></i> Pacientes en Sala de Espera
  </a>
</div>

<!-- Búsqueda en tiempo real -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <div class="col-12 col-md-9 col-lg-10">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
          <input type="search" id="filtro_historiales" value="<%= q %>" class="form-control border-start-0" placeholder="Buscar por paciente, cédula o teléfono..." autocomplete="off">
        </div>
      </div>
      <div class="col-12 col-md-3 col-lg-2 text-md-end">
        <span class="fs-7 text-muted" id="contador_historiales"><%= pacientes.length %> paciente(s)</span>
      </div>
    </div>
  </div>
</div>

<!-- Listado de Fichas Clínicas -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Paciente</th>
            <th class="text-nowrap">Identificación</th>
            <th>Alergias / Antecedentes</th>
            <th>Aseguradora</th>
            <th>Atenciones</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody id="tabla_historiales">
          <% if (pacientes && pacientes.length > 0) { %>
            <% pacientes.forEach(function(p) { %>
              <%
                const cedula = (p.tipo_documento || 'Cédula') === 'Cédula' ? formatearCedula(p.identificacion) : p.identificacion;
                const edad = calcularEdad(p.fecha_nacimiento);
                const sinSeguro = !p.ars_nombre || String(p.ars_codigo || '').toUpperCase() === 'PRIV';
              %>
              <tr data-texto="<%= [p.nombre, p.apellido, cedula, String(p.identificacion || '').replace(/\D/g, ''), p.telefono, String(p.telefono || '').replace(/\D/g, '')].join(' ') %>">
                <td>
                  <div class="fw-bold text-dark"><%= p.nombre %> <%= p.apellido %></div>
                  <small class="text-muted">
                    <%= p.genero %> &middot; <%= formatoFecha(p.fecha_nacimiento) %><% if (edad !== null) { %> &middot; <%= edad %> <%= edad === 1 ? 'año' : 'años' %><% } %>
                  </small>
                </td>
                <td class="font-monospace text-secondary text-nowrap"><%= cedula %></td>
                <td>
                  <%- include('../partials/alergias', { texto: p.antecedentes_alergicos }) %>
                  <% if (p.antecedentes_personales) { %>
                    <div class="fs-8 text-secondary mt-1 text-truncate" style="max-width: 260px;">
                      <%= p.antecedentes_personales %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= sinSeguro ? 'Sin seguro (Privado)' : p.ars_nombre %></span>
                </td>
                <td>
                  <span class="badge bg-teal-subtle text-teal fw-semibold"><%= p.total_consultas %> consulta(s)</span>
                  <% if (p.ultima_consulta) { %>
                    <small class="d-block text-muted fs-8">Última: <%= formatoFecha(p.ultima_consulta) %></small>
                  <% } %>
                </td>
                <td class="text-end">
                  <a href="/consultas/historial/<%= p.id %>" class="btn btn-sm btn-outline-teal text-nowrap">
                    <i class="bi bi-file-earmark-medical me-1"></i> Abrir Historial
                  </a>
                </td>
              </tr>
            <% }); %>
            <tr id="fila_sin_historiales" class="d-none">
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-search fs-1 d-block mb-2 text-teal-light"></i>
                Ningún paciente coincide con la búsqueda.
              </td>
            </tr>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-folder-x fs-1 d-block mb-2 text-teal-light"></i>
                <h6 class="fw-bold text-dark">No se encontraron historiales clínicos</h6>
                <p class="mb-0">Intente con otro término de búsqueda.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
(function () {
  const input = document.getElementById('filtro_historiales');
  const contador = document.getElementById('contador_historiales');
  const sinResultados = document.getElementById('fila_sin_historiales');
  const filas = Array.from(document.querySelectorAll('#tabla_historiales tr[data-texto]'));
  // Sin tildes y en minúsculas ("maria" encuentra "María"); la cédula se busca con o sin guiones
  const limpiar = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
  filas.forEach((f) => { f.dataset.busqueda = limpiar(f.dataset.texto); });

  function filtrar() {
    const palabras = limpiar(input.value).split(/\s+/).filter(Boolean);
    let visibles = 0;
    filas.forEach((f) => {
      const coincide = palabras.every((p) => f.dataset.busqueda.includes(p) || f.dataset.busqueda.includes(p.replace(/-/g, '')));
      f.classList.toggle('d-none', !coincide);
      if (coincide) visibles++;
    });
    if (sinResultados) sinResultados.classList.toggle('d-none', visibles > 0);
    contador.textContent = `${visibles} paciente(s)`;
  }

  input.addEventListener('input', filtrar);
  filtrar();
})();
</script>

<%- include('../partials/footer') %>
