<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-clipboard2-pulse-fill text-teal me-2"></i>Historial de Consultas Médicas
    </h1>
    <p class="text-muted mb-0">Registro y evolución clínica de todas las atenciones médicas realizadas en el consultorio.</p>
  </div>
  <a href="/citas/sala-espera" class="btn btn-teal fw-semibold shadow-sm">
    <i class="bi bi-bell-fill me-1"></i> Ver Sala de Espera
  </a>
</div>

<!-- Filtro de Búsqueda -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <form action="/consultas" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-9 col-lg-10">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="q" value="<%= q %>" class="form-control border-start-0" placeholder="Buscar consulta por paciente, identificación o diagnóstico clínico...">
        </div>
      </div>
      <div class="col-6 col-md-3 col-lg-2 d-grid">
        <button type="submit" class="btn btn-teal fw-semibold">
          <i class="bi bi-funnel me-1"></i> Buscar
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Listado de Consultas -->
<%
  const puedeVerFacturacion = usuarioActual && ['ADMINISTRADOR', 'SECRETARIA', 'RECEPCION'].includes(usuarioActual.rol);
%>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Fecha</th>
            <th>Paciente</th>
            <th>Servicio</th>
            <th>Diagnóstico Clínico</th>
            <th><%= puedeVerFacturacion ? 'ARS & Cobro' : 'Aseguradora ARS' %></th>
            <% if (puedeVerFacturacion) { %>
              <th>Comprobante e-CF</th>
            <% } %>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (consultas && consultas.length > 0) { %>
            <% consultas.forEach(function(c) { %>
              <tr>
                <td>
                  <span class="fw-bold text-dark"><%= formatoFecha(c.fecha_consulta) %></span>
                  <small class="d-block text-muted">
                    <%= new Date(c.fecha_consulta).toLocaleTimeString('es-DO', {hour:'2-digit', minute:'2-digit'}) %>
                  </small>
                </td>
                <td>
                  <a href="/pacientes/<%= c.paciente_id %>" class="fw-semibold text-dark text-decoration-none hover-teal">
                    <%= c.paciente_nombre %> <%= c.paciente_apellido %>
                  </a>
                  <div class="fs-8 text-muted font-monospace"><%= c.paciente_identificacion %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <%= c.servicio_nombre || 'Consulta General' %>
                  </span>
                </td>
                <td>
                  <span class="fw-bold text-dark fs-7"><%= c.diagnostico_clinico %></span>
                  <p class="text-muted fs-8 mb-0 text-truncate" style="max-width: 280px;">
                    <%= c.tratamiento_plan %>
                  </p>
                </td>
                <td>
                  <div><span class="badge bg-light text-secondary border"><%= c.ars_nombre || 'Particular' %></span></div>
                  <% if (puedeVerFacturacion && typeof c.valor_total !== 'undefined') { %>
                    <div class="fs-8 mt-1">
                      <span class="text-muted">Total: <%= formatoMoneda(c.valor_total) %></span>
                      <strong class="text-teal ms-1">Copago: <%= formatoMoneda(c.diferencia_paciente) %></strong>
                    </div>
                  <% } %>
                </td>
                <% if (puedeVerFacturacion) { %>
                  <td>
                    <% if (c.ecf_encf) { %>
                      <span class="font-monospace fw-bold text-dark d-block fs-8"><%= c.ecf_encf %></span>
                      <span class="badge <%= c.ecfEstadoInfo ? c.ecfEstadoInfo.claseBadge : 'bg-secondary' %> fs-8">
                        <%= c.ecf_estado %>
                      </span>
                    <% } else if (c.ecfEstadoInfo) { %>
                      <span class="badge <%= c.ecfEstadoInfo.claseBadge %> fs-8"><%= c.ecf_estado %></span>
                    <% } else { %>
                      <span class="badge bg-light text-secondary border fs-8">Sin emitir</span>
                    <% } %>
                  </td>
                <% } %>
                <td class="text-end">
                  <div class="d-inline-flex gap-1">
                    <a href="/consultas/<%= c.id %>" class="btn btn-sm btn-outline-teal">
                      <i class="bi bi-eye me-1"></i> Ver Ficha
                    </a>
                    <% if (puedeVerFacturacion) { %>
                      <a href="/ecf/factura/<%= c.id %>" class="btn btn-sm btn-teal" title="Gestionar comprobante electrónico e-CF">
                        <i class="bi bi-receipt-cutoff"></i> e-CF
                      </a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="<%= puedeVerFacturacion ? 7 : 6 %>" class="text-center py-5 text-muted">
                <i class="bi bi-clipboard2-x fs-1 d-block mb-2 text-teal-light"></i>
                <h6 class="fw-bold text-dark">No hay consultas registradas</h6>
                <p class="mb-3">Las consultas realizadas por el médico aparecerán aquí.</p>
                <a href="/citas/sala-espera" class="btn btn-teal btn-sm fw-semibold">
                  <i class="bi bi-person-walking me-1"></i> Ir a Sala de Espera para Atender
                </a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

