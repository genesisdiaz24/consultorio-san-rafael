<%- include('../partials/header') %>

<%
  const totalItems = detalles ? detalles.length : 0;
  const totalEntregados = detalles ? detalles.filter(d => d.estado_dispensacion === 'Entregado').length : 0;
  const totalNoEntregados = detalles ? detalles.filter(d => d.estado_dispensacion === 'No entregado' || d.estado_dispensacion === 'No entregado - Sin existencias').length : 0;
  const totalPendientes = totalItems - totalEntregados - totalNoEntregados;
%>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 d-print-none">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-prescription text-teal me-2"></i>Receta Médica: <%= receta.codigo_receta %>
    </h1>
    <p class="text-muted mb-0">Paciente: <strong><%= receta.paciente_nombre %> <%= receta.paciente_apellido %></strong> &bull; Fecha: <%= formatoFecha(receta.fecha_emision) %></p>
  </div>
  <div class="d-flex gap-2">
    <% if (usuarioActual && (usuarioActual.rol === 'FARMACIA' || usuarioActual.rol === 'ADMINISTRADOR')) { %>
      <a href="/farmacia/dispensar/<%= receta.id %>" class="btn btn-outline-teal fw-semibold">
        <i class="bi bi-capsule me-1"></i> Gestionar en Farmacia
      </a>
    <% } %>
    <button onclick="window.print()" class="btn btn-teal fw-semibold shadow-sm">
      <i class="bi bi-printer me-1"></i> Imprimir Receta
    </button>
    <a href="/consultas/recetas" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver a Recetas
    </a>
  </div>
</div>

<!-- Formato Oficial de la Receta para Impresión y Visualización -->
<div class="card border shadow-sm p-4 print-card">
  <!-- Cabecera Institucional -->
  <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
    <div>
      <h3 class="fw-bold text-teal mb-0"><i class="bi bi-hospital me-2"></i><%= clinicName %></h3>
      <p class="text-muted mb-0 fs-7"><%= clinicAddress %> &bull; Tel: <%= clinicPhone %></p>
    </div>
    <div class="text-end">
      <span class="badge bg-teal fs-7 px-3 py-2 font-monospace"><%= receta.codigo_receta %></span>
      <div class="text-muted fs-8 mt-1">Fecha: <%= formatoFecha(receta.fecha_emision) %></div>
    </div>
  </div>

  <!-- Datos del Paciente -->
  <div class="bg-light p-3 rounded mb-4 border">
    <div class="row g-2">
      <div class="col-12 col-md-6">
        <strong class="text-secondary fs-8 text-uppercase">Paciente:</strong>
        <div class="fs-6 fw-bold text-dark"><%= receta.paciente_nombre %> <%= receta.paciente_apellido %></div>
        <div class="fs-8 text-muted">Cédula: <%= receta.paciente_identificacion %></div>
      </div>
      <div class="col-12 col-md-6 text-md-end">
        <strong class="text-secondary fs-8 text-uppercase">Diagnóstico Clínico:</strong>
        <div class="fs-7 fw-bold text-dark"><%= receta.diagnostico_clinico %></div>
        <div class="fs-8">
          Seguro: 
          <% if (receta.ars_nombre && receta.ars_nombre !== 'Particular') { %>
            <span class="badge bg-primary-subtle text-primary border border-primary"><i class="bi bi-shield-check me-1"></i><%= receta.ars_nombre %></span>
          <% } else { %>
            <span class="badge bg-secondary-subtle text-secondary border"><i class="bi bi-person me-1"></i>Particular (Sin seguro)</span>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Estado de Dispensación en Farmacia (Resumen) -->
  <div class="card mb-4 border-0 shadow-xs bg-light">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-clipboard2-pulse fs-4 text-teal"></i>
          <div>
            <strong class="text-dark d-block">Estado de Despacho en Farmacia</strong>
            <small class="text-muted">Resumen de entrega de medicamentos prescritos</small>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
            <i class="bi bi-check-circle-fill me-1"></i> Entregados: <strong><%= totalEntregados %></strong>
          </span>
          <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2">
            <i class="bi bi-x-circle-fill me-1"></i> No entregados: <strong><%= totalNoEntregados %></strong>
          </span>
          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2">
            <i class="bi bi-clock-fill me-1"></i> Pendientes: <strong><%= totalPendientes %></strong>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Indicaciones Generales si existen -->
  <% if (receta.indicaciones_generales) { %>
    <div class="alert alert-info border-info mb-4 fs-7 py-2">
      <strong><i class="bi bi-info-circle me-1"></i>Indicaciones Generales:</strong> <%= receta.indicaciones_generales %>
    </div>
  <% } %>

  <!-- Lista de Fármacos Prescritos y Estado de Dispensación -->
  <h6 class="fw-bold text-secondary text-uppercase fs-8 mb-2">Prescripción Farmacológica y Estado de Entrega:</h6>
  <div class="table-responsive mb-4">
    <table class="table table-bordered align-middle">
      <thead class="table-light fs-8 text-uppercase">
        <tr>
          <th style="width: 5%;">#</th>
          <th style="width: 25%;">Medicamento</th>
          <th style="width: 15%;">Dosis</th>
          <th style="width: 15%;">Frecuencia</th>
          <th style="width: 15%;">Indicaciones</th>
          <th class="text-center" style="width: 7%;">Cant.</th>
          <th style="width: 18%;">Estado en Farmacia</th>
        </tr>
      </thead>
      <tbody>
        <% if (detalles && detalles.length > 0) { %>
          <% detalles.forEach(function(d, index) { %>
            <tr>
              <td class="text-muted fw-bold"><%= index + 1 %></td>
              <td>
                <strong class="text-dark"><%= d.nombre_medicamento %></strong>
                <% if (d.cubierto_ars === false || !receta.ars_nombre || receta.ars_nombre === 'Particular') { %>
                  <div class="fs-8 text-warning-emphasis mt-1">
                    <i class="bi bi-exclamation-circle me-1"></i>No cubierto por seguro
                  </div>
                <% } %>
              </td>
              <td><%= d.dosis %></td>
              <td><%= d.frecuencia %></td>
              <td><%= d.indicaciones_uso %></td>
              <td class="text-center fw-bold"><%= d.cantidad_recetada %></td>
              <td>
                <% if (d.estado_dispensacion === 'Entregado') { %>
                  <span class="badge bg-success-subtle text-success border border-success d-inline-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-1"></i>Entregado (<%= d.cantidad_entregada || d.cantidad_recetada %> unds)
                  </span>
                  <% if (d.cobertura_utilizada) { %>
                    <div class="fs-8 text-success mt-1 fw-semibold">
                      <i class="bi bi-shield-check me-1"></i>Cobertura ARS utilizada
                    </div>
                  <% } else { %>
                    <div class="fs-8 text-muted mt-1">
                      <i class="bi bi-person me-1"></i>Adquirido particular
                    </div>
                  <% } %>
                  <% if (d.observacion_farmacia) { %>
                    <div class="fs-8 text-muted fst-italic mt-1"><%= d.observacion_farmacia %></div>
                  <% } %>
                <% } else if (d.estado_dispensacion === 'No entregado' || d.estado_dispensacion === 'No entregado - Sin existencias') { %>
                  <span class="badge bg-danger-subtle text-danger border border-danger d-inline-flex align-items-center">
                    <i class="bi bi-x-circle-fill me-1"></i>No entregado
                  </span>
                  <div class="fs-8 text-danger fw-semibold mt-1">
                    <i class="bi bi-chat-square-text me-1"></i>Motivo: <%= d.motivo_no_entrega || d.observacion_farmacia || 'Sin existencias' %>
                  </div>
                  <div class="fs-8 text-muted fst-italic">Comprar por cuenta propia en farmacia externa</div>
                <% } else { %>
                  <span class="badge bg-warning-subtle text-warning-emphasis border border-warning d-inline-flex align-items-center">
                    <i class="bi bi-clock-fill me-1"></i>Pendiente
                  </span>
                  <% if (d.cubierto_ars === false || !receta.ars_nombre || receta.ars_nombre === 'Particular') { %>
                    <div class="fs-8 text-danger mt-1">
                      <i class="bi bi-exclamation-triangle me-1"></i>Comprar por su cuenta
                    </div>
                  <% } else { %>
                    <div class="fs-8 text-muted mt-1">
                      <i class="bi bi-shield-check me-1"></i>Elegible para ARS
                    </div>
                  <% } %>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pie de Firma Médica -->
  <div class="row mt-5 pt-4 border-top">
    <div class="col-6">
      <small class="text-muted fs-8">Esta receta es válida para farmacia interna o externa.</small>
    </div>
    <div class="col-6 text-end">
      <div class="d-inline-block text-center" style="border-top: 1px solid #333; width: 220px; padding-top: 4px;">
        <% if (receta.medico_nombre) { %><span class="fs-7 text-dark d-block fw-semibold"><%= receta.medico_nombre %></span><% } %>
        <strong class="fs-8 text-dark d-block">Firma y Sello Médico</strong>
        <small class="text-muted fs-8"><%= clinicName %></small>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

