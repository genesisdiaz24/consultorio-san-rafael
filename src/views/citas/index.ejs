<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-calendar2-check-fill text-teal me-2"></i>Agenda y Control de Citas
    </h1>
    <p class="text-muted mb-0">Gestión de citas solicitadas por teléfono, mensajería o presencialmente en recepción.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/citas/sala-espera" class="btn btn-outline-warning text-dark fw-semibold">
      <i class="bi bi-bell-fill me-1 text-warning"></i> Sala de Espera
    </a>
    <a href="/citas/nueva" class="btn btn-teal fw-semibold shadow-sm">
      <i class="bi bi-calendar-plus me-1"></i> Agendar Cita
    </a>
  </div>
</div>

<!-- Filtros de la Agenda -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <form action="/citas" method="GET" class="row g-2 align-items-end">
      <div class="col-12 col-md-3">
        <label for="fecha" class="form-label fs-8 fw-semibold text-secondary">Fecha</label>
        <input type="date" name="fecha" id="fecha" value="<%= filtros.fecha %>" class="form-control form-control-sm">
      </div>
      <div class="col-12 col-md-3">
        <label for="canal" class="form-label fs-8 fw-semibold text-secondary">Canal de Solicitud</label>
        <select name="canal" id="canal" class="form-select form-select-sm">
          <option value="">Todos los canales</option>
          <option value="Teléfono" <%= filtros.canal === 'Teléfono' ? 'selected' : '' %>>Teléfono</option>
          <option value="Mensajería" <%= filtros.canal === 'Mensajería' ? 'selected' : '' %>>Mensajería (WhatsApp / Chat)</option>
          <option value="Presencial" <%= filtros.canal === 'Presencial' ? 'selected' : '' %>>Presencial (Mostrador)</option>
        </select>
      </div>
      <div class="col-12 col-md-3">
        <label for="estado" class="form-label fs-8 fw-semibold text-secondary">Estado de la Cita</label>
        <select name="estado" id="estado" class="form-select form-select-sm">
          <option value="">Todos los estados</option>
          <option value="Programada" <%= filtros.estado === 'Programada' ? 'selected' : '' %>>Programada</option>
          <option value="En sala de espera" <%= filtros.estado === 'En sala de espera' ? 'selected' : '' %>>En sala de espera</option>
          <option value="Atendida" <%= filtros.estado === 'Atendida' ? 'selected' : '' %>>Atendida</option>
          <option value="Cancelada" <%= filtros.estado === 'Cancelada' ? 'selected' : '' %>>Cancelada</option>
        </select>
      </div>
      <div class="col-12 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-teal fw-semibold flex-grow-1">
          <i class="bi bi-funnel me-1"></i> Filtrar
        </button>
        <a href="/citas" class="btn btn-sm btn-outline-secondary">Limpiar</a>
      </div>
    </form>
  </div>
</div>

<!-- Listado de Citas -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Fecha y Hora</th>
            <th>Paciente</th>
            <th>Canal de Origen</th>
            <th>Contacto</th>
            <th>Motivo de Consulta</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (citas && citas.length > 0) { %>
            <% citas.forEach(function(c) { %>
              <tr>
                <td>
                  <div class="fw-bold text-dark"><%= formatoFecha(c.fecha) %></div>
                  <div class="text-teal font-monospace fs-7"><i class="bi bi-clock me-1"></i><%= c.hora.substring(0, 5) %></div>
                </td>
                <td>
                  <a href="/pacientes/<%= c.paciente_id %>" class="fw-semibold text-dark text-decoration-none hover-teal">
                    <%= c.paciente_nombre %> <%= c.paciente_apellido %>
                  </a>
                  <div class="fs-8 text-muted font-monospace"><%= c.paciente_identificacion %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <% if (c.canal_solicitud === 'Teléfono') { %>
                      <i class="bi bi-telephone-fill text-primary me-1"></i>Teléfono
                    <% } else if (c.canal_solicitud === 'Mensajería') { %>
                      <i class="bi bi-chat-dots-fill text-success me-1"></i>Mensajería
                    <% } else { %>
                      <i class="bi bi-person-badge-fill text-secondary me-1"></i>Presencial
                    <% } %>
                  </span>
                </td>
                <td>
                  <div class="fs-8"><i class="bi bi-telephone me-1 text-muted"></i><%= c.telefono_contacto %></div>
                  <% if (c.correo_contacto) { %>
                    <div class="fs-8 text-muted"><i class="bi bi-envelope me-1"></i><%= c.correo_contacto %></div>
                  <% } %>
                </td>
                <td>
                  <span class="fs-7"><%= c.motivo %></span>
                  <% if (c.servicio_nombre) { %>
                    <small class="d-block text-teal"><%= c.servicio_nombre %></small>
                  <% } %>
                </td>
                <td>
                  <% if (c.estado === 'En sala de espera') { %>
                    <span class="badge bg-warning text-dark"><i class="bi bi-bell-fill me-1"></i>En sala de espera</span>
                  <% } else if (c.estado === 'Atendida') { %>
                    <span class="badge bg-success">Atendida</span>
                  <% } else if (c.estado === 'Cancelada') { %>
                    <span class="badge bg-danger">Cancelada</span>
                  <% } else { %>
                    <span class="badge bg-primary">Programada</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (c.estado === 'Programada') { %>
                    <form action="/citas/<%= c.id %>/confirmar-llegada" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-success fw-semibold" title="Confirmar llegada del paciente a la clínica">
                        <i class="bi bi-person-check-fill me-1"></i> Llegada
                      </button>
                    </form>
                    <form action="/citas/<%= c.id %>/cancelar" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que desea cancelar esta cita?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar cita">
                        <i class="bi bi-x-lg"></i>
                      </button>
                    </form>
                  <% } else if (c.estado === 'En sala de espera') { %>
                    <a href="/consultas/atender?paciente_id=<%= c.paciente_id %>&cita_id=<%= c.id %>" class="btn btn-sm btn-success fw-bold">
                      <i class="bi bi-stethoscope me-1"></i> Atender
                    </a>
                  <% } else if (c.estado === 'Atendida') { %>
                    <span class="badge bg-light text-muted border">Finalizada</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <i class="bi bi-calendar2-x fs-1 d-block mb-2 text-teal-light"></i>
                <h6 class="fw-bold text-dark">No hay citas registradas</h6>
                <p class="mb-3">No hay citas que coincidan con los filtros seleccionados.</p>
                <a href="/citas/nueva" class="btn btn-teal btn-sm fw-semibold">
                  <i class="bi bi-calendar-plus me-1"></i> Agendar Nueva Cita
                </a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

