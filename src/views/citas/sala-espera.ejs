<%- include('../partials/header') %>
<%
  const rolSesion = usuarioActual ? usuarioActual.rol : '';
  // El motivo es información clínica: solo lo ven el médico y el administrador
  const verMotivo = ['MEDICO', 'ADMINISTRADOR'].includes(rolSesion);
  const puedeGestionarAgenda = ['ADMINISTRADOR', 'SECRETARIA', 'RECEPCION'].includes(rolSesion);
  const puedeVerFarmacia = ['ADMINISTRADOR', 'FARMACIA'].includes(rolSesion);
%>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-bell-fill text-warning me-2"></i>Sala de Espera &bull; Pacientes Listos
    </h1>
    <p class="text-muted mb-0">Panel de notificación para el médico. Pacientes que han confirmado su llegada a la clínica.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/citas/sala-espera" class="btn btn-outline-teal btn-sm fw-semibold">
      <i class="bi bi-arrow-clockwise me-1"></i> Actualizar Monitor
    </a>
    <% if (puedeGestionarAgenda) { %>
      <a href="/citas" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-calendar3 me-1"></i> Ver Toda la Agenda
      </a>
    <% } %>
  </div>
</div>

<!-- Banner de Estado Médico -->
<div class="alert bg-white border shadow-sm p-4 mb-4 rounded-3">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
    <div class="d-flex align-items-center gap-3">
      <div class="rounded-circle bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
        <i class="bi bi-person-wheelchair fs-2"></i>
      </div>
      <div>
        <h5 class="fw-bold mb-1 text-dark">
          <%= enEspera.length %> Paciente(s) en espera de turno
        </h5>
        <p class="text-secondary mb-0 fs-7">
          Al confirmar la llegada en recepción, el paciente aparece inmediatamente en esta lista y el médico recibe la señal de disponibilidad.
        </p>
      </div>
    </div>
    <% if (enEspera.length > 0) { %>
      <div class="badge bg-danger fs-6 py-2 px-3 animate-pulse">
        <i class="bi bi-broadcast me-1"></i> Paciente Disponible para Pasar al Consultorio
      </div>
    <% } else { %>
      <div class="badge bg-success-subtle text-success fs-7 py-2 px-3">
        <i class="bi bi-check2-all me-1"></i> No hay pacientes en espera en este instante
      </div>
    <% } %>
  </div>
</div>

<!-- Tarjetas y Lista de Pacientes en Espera -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Orden / Llegada</th>
            <th>Paciente</th>
            <th>Tiempo en Espera</th>
            <% if (verMotivo) { %><th>Alergias</th><% } %>
            <th>ARS / Seguro</th>
            <th><%= verMotivo ? 'Motivo de la Consulta' : 'Servicio' %></th>
            <th class="text-end">Acción del Médico</th>
          </tr>
        </thead>
        <tbody>
          <% if (enEspera && enEspera.length > 0) { %>
            <% enEspera.forEach(function(c, index) { %>
              <tr class="<%= index === 0 ? 'table-warning-subtle' : '' %>">
                <td>
                  <span class="badge rounded-pill bg-dark me-2">#<%= index + 1 %></span>
                  <span class="text-muted fs-8">
                    Llegó: <%= c.fecha_llegada ? new Date(c.fecha_llegada).toLocaleTimeString('es-DO', {hour: '2-digit', minute:'2-digit'}) : 'N/A' %>
                  </span>
                </td>
                <td>
                  <a href="/pacientes/<%= c.paciente_id %>" class="fw-bold text-dark text-decoration-none hover-teal fs-6">
                    <%= c.paciente_nombre %> <%= c.paciente_apellido %>
                  </a>
                  <div class="fs-8 text-muted font-monospace">
                    ID: <%= c.paciente_identificacion %> &bull; Tel: <%= c.paciente_telefono %>
                  </div>
                </td>
                <td>
                  <span class="badge bg-warning text-dark font-monospace fs-7">
                    <i class="bi bi-hourglass-split me-1"></i><%= c.minutos_espera || 0 %> min
                  </span>
                </td>
                <% if (verMotivo) { %>
                  <td><%- include('../partials/alergias', { texto: c.antecedentes_alergicos }) %></td>
                <% } %>
                <td>
                  <% if (c.ars_nombre) { %>
                    <span class="badge bg-teal-subtle text-teal">
                      <i class="bi bi-shield-check me-1"></i><%= c.ars_nombre %>
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-muted border">Particular</span>
                  <% } %>
                </td>
                <td>
                  <% if (verMotivo && c.motivo) { %>
                    <div class="fw-semibold fs-7"><%= c.motivo %></div>
                  <% } %>
                  <small class="text-muted"><%= c.servicio_nombre || 'Consulta General' %></small>
                </td>
                <td class="text-end">
                  <a href="/consultas/atender?paciente_id=<%= c.paciente_id %>&cita_id=<%= c.id %>" class="btn btn-success fw-bold px-3 shadow-sm">
                    <i class="bi bi-stethoscope me-1"></i> Llamar y Atender
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="<%= verMotivo ? 7 : 6 %>" class="text-center py-5 text-muted">
                <i class="bi bi-cup-hot fs-1 d-block mb-2 text-secondary opacity-50"></i>
                <h6 class="fw-bold text-dark">La Sala de Espera está vacía</h6>
                <p class="mb-3">Cuando los pacientes lleguen a la clínica y se confirme su asistencia, aparecerán listados aquí.</p>
                <% if (puedeGestionarAgenda) { %>
                  <a href="/citas" class="btn btn-outline-teal btn-sm fw-semibold">
                    <i class="bi bi-calendar3 me-1"></i> Ver Agenda de Citas Programadas
                  </a>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

