<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Consultorio Médico San Rafael' %></title>
  <!-- Bootstrap 5 CSS via CDN con diseño limpio y responsivo -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <!-- Estilos personalizados del consultorio -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<% 
  // Manejo defensivo y seguro para que usuario y ruta siempre estén definidos en cualquier vista o error
  const usuario = (typeof usuarioActual !== 'undefined' && usuarioActual) ? usuarioActual : null;
  const ruta = (typeof pathActual !== 'undefined' && pathActual) ? pathActual : '';
%>

<!-- Barra de navegación responsiva (Adaptada a computadoras y teléfonos) -->
<nav class="navbar navbar-expand-lg navbar-dark bg-teal sticky-top shadow-sm">
  <div class="container-fluid px-3 px-lg-4">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/">
      <span class="brand-icon"><i class="bi bi-hospital"></i></span>
      <div class="d-flex flex-column lh-1">
        <span class="fs-5">San Rafael</span>
        <small class="fs-8 text-teal-light text-uppercase">Consultorio Médico</small>
      </div>
    </a>

    <% if (usuario) { %>
      <!-- Botón hamburguesa para teléfonos móviles -->
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navSanRafael" aria-controls="navSanRafael" aria-expanded="false" aria-label="Abrir menú de navegación">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navSanRafael">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-lg-1">
          
          <!-- Panel Principal (Todos los roles) -->
          <li class="nav-item">
            <a class="nav-link <%= ruta === '/' ? 'active fw-semibold' : '' %>" href="/">
              <i class="bi bi-speedometer2 me-1"></i> Panel
            </a>
          </li>

          <!-- 1. MÓDULOS DE SECRETARÍA (Pacientes, Citas, Sala de Espera, ARS y Cobros) -->
          <% if (['SECRETARIA', 'RECEPCION'].includes(usuario.rol)) { %>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/pacientes') ? 'active fw-semibold' : '' %>" href="/pacientes">
                <i class="bi bi-people me-1"></i> Pacientes
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= ruta === '/citas' || ruta === '/citas/nueva' ? 'active fw-semibold' : '' %>" href="/citas">
                <i class="bi bi-calendar2-check me-1"></i> Citas
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link position-relative <%= ruta.startsWith('/citas/sala-espera') ? 'active fw-semibold' : '' %>" href="/citas/sala-espera">
                <i class="bi bi-bell-fill me-1 text-warning"></i> Sala de Espera
              </a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle <%= ruta.startsWith('/ars') ? 'active fw-semibold' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-shield-check me-1"></i> ARS &amp; Cobros
              </a>
              <ul class="dropdown-menu shadow-sm">
                <li><a class="dropdown-item <%= ruta.startsWith('/ars/cobrar') ? 'active fw-semibold text-success' : '' %>" href="/ars/cobrar"><i class="bi bi-cash-coin me-2 text-success"></i>Cobrar</a></li>
                <li><a class="dropdown-item <%= (ruta === '/ars' || ruta === '/ars/nueva') ? 'active fw-semibold' : '' %>" href="/ars"><i class="bi bi-building-check me-2 text-teal"></i>Aseguradoras (ARS)</a></li>
                <li><a class="dropdown-item <%= ruta.startsWith('/ars/calcular') ? 'active fw-semibold' : '' %>" href="/ars/calcular"><i class="bi bi-calculator me-2 text-success"></i>Calculadora de Copago</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item <%= ruta.startsWith('/ecf') ? 'active fw-semibold' : '' %>" href="/ecf"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Comprobantes Electrónicos (e-CF)</a></li>
              </ul>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/ecf') ? 'active fw-semibold' : '' %>" href="/ecf">
                <i class="bi bi-receipt-cutoff me-1"></i> Facturación e-CF
              </a>
            </li>
          <% } %>

          <!-- 2. MÓDULOS DE MÉDICO (Consultas, Historiales, Recetas y Sala de Espera; Facturación e-CF bloqueada) -->
          <% if (usuario.rol === 'MEDICO') { %>
            <li class="nav-item">
              <a class="nav-link <%= ruta === '/consultas' ? 'active fw-semibold' : '' %>" href="/consultas">
                <i class="bi bi-clipboard2-pulse me-1"></i> Consultas
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/consultas/historial') ? 'active fw-semibold' : '' %>" href="/consultas/historial">
                <i class="bi bi-journal-medical me-1"></i> Historiales
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/consultas/recetas') ? 'active fw-semibold' : '' %>" href="/consultas/recetas">
                <i class="bi bi-prescription me-1"></i> Recetas
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link position-relative <%= ruta.startsWith('/citas/sala-espera') ? 'active fw-semibold' : '' %>" href="/citas/sala-espera">
                <i class="bi bi-bell-fill me-1 text-warning"></i> Sala de Espera
              </a>
            </li>
          <% } %>

          <!-- 3. MÓDULOS DE FARMACIA (Recetas por Dispensar, Inventario y Asistente IA) -->
          <% if (usuario.rol === 'FARMACIA') { %>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/farmacia/dispensar') ? 'active fw-semibold' : '' %>" href="/farmacia/dispensar">
                <i class="bi bi-check2-circle me-1"></i> Dispensar Recetas
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/farmacia/inventario') ? 'active fw-semibold' : '' %>" href="/farmacia/inventario">
                <i class="bi bi-boxes me-1"></i> Inventario
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/farmacia/movimientos') ? 'active fw-semibold' : '' %>" href="/farmacia/movimientos">
                <i class="bi bi-clock-history me-1"></i> Movimientos
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/farmacia/chat') ? 'active fw-semibold' : '' %>" href="/farmacia/chat">
                <i class="bi bi-robot me-1 text-teal"></i> Asistente IA
              </a>
            </li>
          <% } %>

          <!-- 4. MÓDULOS DE ADMINISTRADOR (Usuarios, Tarifarios, Medicamentos, e-CF y Supervisión) -->
          <% if (usuario.rol === 'ADMINISTRADOR') { %>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/usuarios') ? 'active fw-semibold' : '' %>" href="/usuarios">
                <i class="bi bi-person-gear me-1"></i> Usuarios
              </a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle <%= ruta.startsWith('/ars') ? 'active fw-semibold' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-shield-check me-1"></i> ARS &amp; Cobros
              </a>
              <ul class="dropdown-menu shadow-sm">
                <li><a class="dropdown-item <%= ruta.startsWith('/ars/cobrar') ? 'active fw-semibold text-success' : '' %>" href="/ars/cobrar"><i class="bi bi-cash-coin me-2 text-success"></i>Cobrar</a></li>
                <li><a class="dropdown-item <%= (ruta === '/ars' || ruta === '/ars/nueva') ? 'active fw-semibold' : '' %>" href="/ars"><i class="bi bi-building-check me-2 text-teal"></i>Tarifarios ARS</a></li>
                <li><a class="dropdown-item <%= ruta.startsWith('/ars/calcular') ? 'active fw-semibold' : '' %>" href="/ars/calcular"><i class="bi bi-calculator me-2 text-primary"></i>Calculadora de Copago</a></li>
              </ul>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/ecf') ? 'active fw-semibold' : '' %>" href="/ecf">
                <i class="bi bi-receipt-cutoff me-1"></i> Facturación e-CF
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= ruta.startsWith('/farmacia/inventario') ? 'active fw-semibold' : '' %>" href="/farmacia/inventario">
                <i class="bi bi-capsule me-1"></i> Medicamentos
              </a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle <%= (ruta.startsWith('/pacientes') || ruta.startsWith('/citas') || ruta.startsWith('/consultas')) ? 'active fw-semibold' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-eye me-1"></i> Supervisión
              </a>
              <ul class="dropdown-menu shadow-sm">
                <li><a class="dropdown-item" href="/pacientes"><i class="bi bi-people me-2 text-teal"></i>Directorio de Pacientes</a></li>
                <li><a class="dropdown-item" href="/citas"><i class="bi bi-calendar2-check me-2 text-primary"></i>Agenda de Citas</a></li>
                <li><a class="dropdown-item" href="/consultas"><i class="bi bi-clipboard2-pulse me-2 text-success"></i>Consultas Médicas</a></li>
                <li><a class="dropdown-item" href="/ecf"><i class="bi bi-receipt-cutoff me-2 text-teal"></i>Comprobantes Electrónicos (e-CF)</a></li>
                <li><a class="dropdown-item" href="/farmacia/dispensar"><i class="bi bi-prescription me-2 text-info"></i>Dispensación Farmacia</a></li>
                <li><a class="dropdown-item <%= ruta.startsWith('/farmacia/chat') ? 'active fw-semibold' : '' %>" href="/farmacia/chat"><i class="bi bi-robot me-2 text-teal"></i>Asistente IA Farmacia</a></li>
              </ul>
            </li>
          <% } %>

          <!-- 5. REPORTES (Todos los roles; cada uno ve los reportes de sus módulos) -->
          <li class="nav-item">
            <a class="nav-link <%= ruta.startsWith('/reportes') ? 'active fw-semibold' : '' %>" href="/reportes">
              <i class="bi bi-file-earmark-bar-graph me-1"></i> Reportes
            </a>
          </li>

        </ul>

        <!-- Perfil del Usuario Conectado y Botón Cerrar Sesión -->
        <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0 pt-2 pt-lg-0 border-top border-lg-0 border-white-50">
          <div class="d-flex flex-column text-end text-white lh-1">
            <span class="fw-bold fs-7"><%= usuario.nombre %></span>
            <small class="fs-8 text-teal-light">
              <span class="badge <%= usuario.rol === 'ADMINISTRADOR' ? 'bg-dark' : (usuario.rol === 'MEDICO' ? 'bg-success' : (['SECRETARIA', 'RECEPCION'].includes(usuario.rol) ? 'bg-primary' : 'bg-warning text-dark')) %>">
                <%= usuario.rol %>
              </span>
            </small>
          </div>
          <form action="/logout" method="POST" class="d-inline mb-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1" title="Cerrar sesión">
              <i class="bi bi-box-arrow-right"></i>
              <span class="d-lg-none ms-1">Salir</span>
            </button>
          </form>
        </div>

      </div>
    <% } else { %>
      <!-- Si no ha iniciado sesión -->
      <div class="ms-auto">
        <a href="/login" class="btn btn-sm btn-light text-teal fw-bold shadow-sm">
          <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
        </a>
      </div>
    <% } %>

  </div>
</nav>

<!-- Contenedor Principal de la Aplicación -->
<main class="container-fluid px-3 px-lg-4 py-4 main-content">
  <%- include('alerts') %>
