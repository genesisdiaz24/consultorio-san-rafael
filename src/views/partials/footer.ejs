      <strong class="text-teal"><%= clinicName %></strong> &bull; <%= clinicAddress %> &bull; Tel: <%= clinicPhone %>
    </div>
    <div class="text-muted">
      Sistema Clínico con Node.js, Express &amp; PostgreSQL &copy; <%= new Date().getFullYear() %>
    </div>
  </div>
</footer>

<!-- Bootstrap Bundle JS con Popper (CDN) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Scripts personalizados -->
