<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 fw-bold text-dark mb-1">
          <i class="bi bi-calculator text-teal me-2"></i>Simulador de Coberturas y Copagos
        </h1>
        <p class="text-muted mb-0">Compruebe en tiempo real los valores de servicio, aporte del seguro y diferencia a pagar por el paciente.</p>
      </div>
      <a href="/ars" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-shield-check me-1"></i> Ir a ARS
      </a>
    </div>

    <!-- Panel de Selección -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label class="form-label fs-7 fw-semibold">1. Seleccione la Aseguradora (ARS)</label>
            <select id="simArs" class="form-select" onchange="ejecutarSimulacion()">
              <option value="0">Particular / Sin Aseguradora (100% Paciente)</option>
              <% if (arsList && arsList.length > 0) { %>
                <% arsList.forEach(function(ars) { %>
                  <option value="<%= ars.id %>"><%= ars.nombre %></option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fs-7 fw-semibold">2. Seleccione el Servicio Médico</label>
            <select id="simServicio" class="form-select" onchange="ejecutarSimulacion()">
              <% if (servicios && servicios.length > 0) { %>
                <% servicios.forEach(function(s) { %>
                  <option value="<%= s.id %>" data-precio="<%= s.precio_base %>">
                    <%= s.nombre %> (Base: <%= formatoMoneda(s.precio_base) %>)
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Resultados del Cálculo -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark">
          <i class="bi bi-cash-stack text-teal me-2"></i>Resultado de la Liquidación
        </h5>
      </div>
      <div class="card-body p-4 pt-0">
        <div class="alert alert-light border p-3 rounded-3 mb-4" id="simMensajeRegla">
          Seleccione una ARS y servicio para consultar la liquidación.
        </div>

        <div class="row g-3 text-center">
          <div class="col-12 col-md-4">
            <div class="p-3 rounded-3 bg-light border">
              <span class="fs-8 text-secondary text-uppercase fw-semibold d-block">Valor del Servicio</span>
              <div class="fs-4 fw-bold text-dark my-1" id="simTotal">RD$ 0.00</div>
              <small class="text-muted fs-8">Tarifa convenida</small>
            </div>
          </div>

          <div class="col-12 col-md-4">
            <div class="p-3 rounded-3 bg-teal-subtle border border-teal">
              <span class="fs-8 text-teal text-uppercase fw-semibold d-block">Cubierto por ARS</span>
              <div class="fs-4 fw-bold text-teal my-1" id="simCubierto">RD$ 0.00</div>
              <small class="text-secondary fs-8" id="simPorcentaje">Aporte seguro</small>
            </div>
          </div>

          <div class="col-12 col-md-4">
            <div class="p-3 rounded-3 bg-warning-subtle border border-warning">
              <span class="fs-8 text-dark text-uppercase fw-semibold d-block">Copago del Paciente</span>
              <div class="fs-4 fw-bold text-danger my-1" id="simCopago">RD$ 0.00</div>
              <small class="text-secondary fs-8">Diferencia a cancelar</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm bg-light">
      <div class="card-body p-3 fs-8 text-secondary">
        <i class="bi bi-info-circle-fill text-teal me-2"></i>
        <strong>Nota del Sistema:</strong> En cumplimiento de los requisitos clínicos, ninguna tarifa ni porcentaje está fijo en código fuente. Todas las coberturas pueden ajustarse en la sección <a href="/ars" class="text-teal fw-semibold">Administración de ARS</a>.
      </div>
    </div>
  </div>
</div>

<script>
const todosLosTarifarios = <%- JSON.stringify(tarifarios || []) %>;

function ejecutarSimulacion() {
  const arsId = parseInt(document.getElementById('simArs').value, 10);
  const servSelect = document.getElementById('simServicio');
  const servId = parseInt(servSelect.value, 10);
  const precioBase = parseFloat(servSelect.options[servSelect.selectedIndex].getAttribute('data-precio')) || 0;

  let total = precioBase;
  let cubierto = 0;
  let copago = precioBase;
  let regla = 'Tarifa base particular (Sin seguro médico asociado). El paciente cubre el 100% del servicio.';
  let detallePorc = '0% cobertura';

  if (arsId > 0) {
    const tarifa = todosLosTarifarios.find(t => t.ars_id === arsId && t.servicio_id === servId);
    if (tarifa) {
      const valCob = parseFloat(tarifa.valor_cobertura);
      const copagoFijo = parseFloat(tarifa.copago_fijo) || 0;
      const liq = liquidarArs({
        valorTotal: tarifa.tarifa_pactada,
        tipoCobertura: tarifa.tipo_cobertura,
        valorCobertura: tarifa.valor_cobertura,
        copagoFijo: tarifa.copago_fijo,
      });
      total = liq.valorTotal;
      cubierto = liq.valorCubierto;
      copago = liq.diferenciaPaciente;
      const notaCopago = copagoFijo > 0 ? ` Copago mínimo del paciente: RD$ ${copagoFijo.toFixed(2)} (incluido).` : '';

      if (tarifa.tipo_cobertura === 'PORCENTAJE') {
        detallePorc = `${valCob}% de cobertura`;
        regla = `Convenio encontrado: Cobertura del ${valCob}% sobre tarifa pactada de RD$ ${total.toFixed(2)}.${notaCopago}`;
      } else {
        detallePorc = `Monto fijo cubierto`;
        regla = `Convenio encontrado: Cobertura fija de RD$ ${valCob.toFixed(2)} sobre tarifa pactada de RD$ ${total.toFixed(2)}.${notaCopago}`;
      }
    } else {
      regla = 'La aseguradora seleccionada no tiene tarifario específico para este servicio. Se aplica tarifa base con 0% de cobertura.';
    }
  }

  document.getElementById('simTotal').innerText = 'RD$ ' + total.toLocaleString('es-DO', {minimumFractionDigits: 2});
  document.getElementById('simCubierto').innerText = 'RD$ ' + cubierto.toLocaleString('es-DO', {minimumFractionDigits: 2});
  document.getElementById('simCopago').innerText = 'RD$ ' + copago.toLocaleString('es-DO', {minimumFractionDigits: 2});
  document.getElementById('simMensajeRegla').innerText = regla;
  document.getElementById('simPorcentaje').innerText = detallePorc;
}

document.addEventListener('DOMContentLoaded', ejecutarSimulacion);
</script>

<%- include('../partials/footer') %>

