<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-cash-coin text-teal me-2"></i>Liquidación, Cobertura ARS y Cobro al Paciente
    </h1>
    <p class="text-muted mb-0">
      Módulo exclusivo de Secretaría: Cobro en caja y liquidación de seguros médicos para atenciones finalizadas por el médico.
    </p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="/ars/calcular" class="btn btn-outline-teal fw-semibold">
      <i class="bi bi-calculator me-1"></i> Calculadora de Copago
    </a>
    <a href="/ecf" class="btn btn-outline-primary fw-semibold">
      <i class="bi bi-receipt-cutoff me-1"></i> Facturación e-CF
    </a>
    <a href="/citas/sala-espera" class="btn btn-light border fw-semibold">
      <i class="bi bi-bell-fill text-warning me-1"></i> Sala de Espera
    </a>
  </div>
</div>

<!-- Tarjetas de Métricas de Cobros -->
<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-lg-4">
    <div class="card card-stat border-0 shadow-sm border-start border-4 border-warning h-100">
      <div class="card-body d-flex align-items-center justify-content-between p-3">
        <div>
          <span class="text-muted text-uppercase fs-8 fw-semibold">Pendientes de Cobro</span>
          <h2 class="fw-bold mb-0 text-dark"><%= metricas.pendientes_cantidad || 0 %></h2>
          <small class="text-danger fw-semibold">
            <i class="bi bi-cash me-1"></i>RD$ <%= parseFloat(metricas.pendientes_monto || 0).toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> por recaudar
          </small>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
          <i class="bi bi-clock-history fs-3"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-lg-4">
    <div class="card card-stat border-0 shadow-sm border-start border-4 border-success h-100">
      <div class="card-body d-flex align-items-center justify-content-between p-3">
        <div>
          <span class="text-muted text-uppercase fs-8 fw-semibold">Cobrado Hoy</span>
          <h2 class="fw-bold mb-0 text-success"><%= metricas.pagados_hoy_cantidad || 0 %></h2>
          <small class="text-success fw-semibold">
            <i class="bi bi-check-circle me-1"></i>RD$ <%= parseFloat(metricas.pagados_hoy_monto || 0).toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> recaudados hoy
          </small>
        </div>
        <div class="stat-icon bg-success-subtle text-success">
          <i class="bi bi-cash-stack fs-3"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-12 col-lg-4">
    <div class="card card-stat border-0 shadow-sm border-start border-4 border-teal h-100">
      <div class="card-body d-flex align-items-center justify-content-between p-3">
        <div>
          <span class="text-muted text-uppercase fs-8 fw-semibold">Total Pagados Registrados</span>
          <h2 class="fw-bold mb-0 text-teal"><%= metricas.total_pagados || 0 %></h2>
          <small class="text-muted">
            <i class="bi bi-shield-check me-1"></i>Histórico de consultas cobradas
          </small>
        </div>
        <div class="stat-icon bg-teal-subtle text-teal">
          <i class="bi bi-check2-circle fs-3"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filtros y Barra de Búsqueda -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <div class="row g-3 align-items-center">
      <!-- Pestañas de Estado -->
      <div class="col-12 col-md-6">
        <div class="nav nav-pills gap-1">
          <a href="/ars/cobrar?estado=Pendiente<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
             class="btn btn-sm <%= filtroEstado === 'Pendiente' ? 'btn-warning text-dark fw-bold' : 'btn-light border' %>">
            <i class="bi bi-clock-history me-1"></i> Pendientes de Cobro
            <span class="badge bg-dark text-white ms-1"><%= metricas.pendientes_cantidad || 0 %></span>
          </a>
          <a href="/ars/cobrar?estado=Pagado<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
             class="btn btn-sm <%= filtroEstado === 'Pagado' ? 'btn-success fw-bold' : 'btn-light border' %>">
            <i class="bi bi-check-circle me-1"></i> Pagados
          </a>
          <a href="/ars/cobrar?estado=Todos<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
             class="btn btn-sm <%= filtroEstado === 'Todos' ? 'btn-teal fw-bold' : 'btn-light border' %>">
            <i class="bi bi-list-ul me-1"></i> Todos
          </a>
        </div>
      </div>

      <!-- Buscador -->
      <div class="col-12 col-md-6">
        <form method="GET" action="/ars/cobrar" class="d-flex gap-2">
          <input type="hidden" name="estado" value="<%= filtroEstado %>">
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" name="q" class="form-control border-start-0"
                   placeholder="Buscar paciente, cédula, servicio o ARS..."
                   value="<%= q %>">
            <% if (q) { %>
              <a href="/ars/cobrar?estado=<%= filtroEstado %>" class="btn btn-outline-secondary" title="Limpiar búsqueda">
                <i class="bi bi-x-lg"></i>
              </a>
            <% } %>
            <button class="btn btn-teal" type="submit">Buscar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Tabla de Cargos y Cobros -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h5 class="fw-bold mb-0 text-dark">
        <i class="bi bi-receipt text-teal me-2"></i>
        <% if (filtroEstado === 'Pendiente') { %>
          Consultas Médicas Pendientes de Cobro
        <% } else if (filtroEstado === 'Pagado') { %>
          Consultas Médicas Cobradas (Pagadas)
        <% } else { %>
          Registro General de Cobros y Liquidaciones
        <% } %>
      </h5>
      <small class="text-muted">
        Las consultas son creadas automáticamente por el médico al finalizar la atención y receta. No se permite cobrar antes de finalizar la consulta ni crear cargos duplicados.
      </small>
    </div>
    <span class="badge bg-light text-dark border">
      <%= cobros.length %> registro(s)
    </span>
  </div>

  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th># Cargo / Fecha</th>
            <th>Paciente &amp; Identificación</th>
            <th>Cita Vinculada</th>
            <th>Servicio Prestado</th>
            <th>ARS &amp; Cobertura</th>
            <th class="text-end">Tarifa Total</th>
            <th class="text-end">Copago Paciente</th>
            <th class="text-center">Estado del Cobro</th>
            <th class="text-end">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% if (cobros && cobros.length > 0) { %>
            <% cobros.forEach(function(c) { %>
              <% const esPendiente = c.estado_pago === 'Pendiente'; %>
              <tr class="<%= esPendiente ? 'table-warning-subtle' : '' %>">
                <td>
                  <span class="fw-bold font-monospace text-dark">#<%= c.consulta_id %></span>
                  <small class="d-block text-muted">
                    <%= new Date(c.fecha_consulta).toLocaleDateString('es-DO', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </small>
                </td>
                <td>
                  <div class="fw-bold text-dark"><%= c.paciente_nombre %> <%= c.paciente_apellido %></div>
                  <div class="text-muted fs-8 font-monospace"><%= c.paciente_identificacion || 'Sin documento' %></div>
                  <% if (c.paciente_telefono) { %>
                    <small class="text-secondary"><i class="bi bi-telephone me-1"></i><%= c.paciente_telefono %></small>
                  <% } %>
                </td>
                <td>
                  <% if (c.cita_id) { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                      <i class="bi bi-check-circle me-1"></i>Cita #<%= c.cita_id %> (Atendida)
                    </span>
                    <% if (c.cita_fecha) { %>
                      <small class="d-block text-muted fs-8"><%= new Date(c.cita_fecha).toLocaleDateString('es-DO') %> <%= c.cita_hora || '' %></small>
                    <% } %>
                  <% } else { %>
                    <span class="badge bg-light text-muted border">Atención Directa</span>
                  <% } %>
                </td>
                <td>
                  <span class="fw-semibold text-dark"><%= c.servicio_nombre || 'Consulta Médica General' %></span>
                  <% if (c.diagnostico_clinico) { %>
                    <small class="d-block text-muted text-truncate" style="max-width: 200px;" title="<%= c.diagnostico_clinico %>">
                      <i class="bi bi-clipboard2-pulse me-1"></i><%= c.diagnostico_clinico %>
                    </small>
                  <% } %>
                </td>
                <td>
                  <% if (c.ars_nombre) { %>
                    <span class="badge bg-teal-subtle text-teal border border-teal-subtle">
                      <i class="bi bi-shield-check me-1"></i><%= c.ars_nombre %>
                    </span>
                    <% if (c.numero_afiliado) { %>
                      <small class="d-block text-muted fs-8">Afiliado: <%= c.numero_afiliado %></small>
                    <% } %>
                    <small class="d-block text-success fs-8">
                      Cubierto: RD$ <%= parseFloat(c.valor_cubierto_ars || 0).toLocaleString('es-DO', { minimumFractionDigits: 2 }) %>
                    </small>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary">
                      Particular (Sin ARS)
                    </span>
                  <% } %>
                </td>
                <td class="text-end font-monospace text-dark">
                  RD$ <%= parseFloat(c.valor_total || 0).toLocaleString('es-DO', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-end">
                  <span class="fs-6 fw-bold <%= esPendiente ? 'text-danger' : 'text-success' %> font-monospace">
                    RD$ <%= parseFloat(c.diferencia_paciente || 0).toLocaleString('es-DO', { minimumFractionDigits: 2 }) %>
                  </span>
                </td>
                <td class="text-center">
                  <% if (esPendiente) { %>
                    <span class="badge bg-warning text-dark px-3 py-2 shadow-sm">
                      <i class="bi bi-clock-history me-1"></i>Pendiente de Cobro
                    </span>
                  <% } else if (c.estado_pago === 'Pagado') { %>
                    <span class="badge bg-success px-3 py-2 shadow-sm">
                      <i class="bi bi-check-circle-fill me-1"></i>Pagado
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary px-3 py-2"><%= c.estado_pago %></span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex gap-1">
                    <% if (esPendiente) { %>
                      <!-- Botón Cobrar (Abre Modal de Cobro) -->
                      <button type="button" class="btn btn-sm btn-success fw-bold px-3 shadow-sm"
                              data-bs-toggle="modal"
                              data-bs-target="#modalCobrar<%= c.consulta_id %>">
                        <i class="bi bi-cash-coin me-1"></i> Cobrar
                      </button>

                      <!-- Menú de Opciones Adicionales -->
                      <div class="dropdown d-inline-block">
                        <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                          <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                          <li>
                            <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#modalAjustar<%= c.consulta_id %>">
                              <i class="bi bi-pencil-square me-2 text-warning"></i>Ajustar Liquidación / ARS
                            </button>
                          </li>
                          <li>
                            <a class="dropdown-item" href="/ecf/factura/<%= c.consulta_id %>">
                              <i class="bi bi-receipt-cutoff me-2 text-primary"></i>Factura y Comprobante e-CF
                            </a>
                          </li>
                        </ul>
                      </div>
                    <% } else { %>
                      <a href="/ecf/factura/<%= c.consulta_id %>" class="btn btn-sm btn-outline-teal fw-semibold">
                        <i class="bi bi-receipt me-1"></i> Ver Factura e-CF
                      </a>
                    <% } %>
                  </div>

                  <% if (esPendiente) { %>
                    <!-- MODAL DE COBRO DE CONSULTA -->
                    <div class="modal fade text-start" id="modalCobrar<%= c.consulta_id %>" tabindex="-1" aria-labelledby="modalCobrarLabel<%= c.consulta_id %>" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                          <form method="POST" action="/ars/cobrar/<%= c.consulta_id %>">
                            <input type="hidden" name="return_to" value="/ars/cobrar?estado=<%= filtroEstado %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">
                            <div class="modal-header bg-teal text-white">
                              <h5 class="modal-title fw-bold" id="modalCobrarLabel<%= c.consulta_id %>">
                                <i class="bi bi-cash-coin me-2"></i>Registrar Cobro &mdash; Consulta #<%= c.consulta_id %>
                              </h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                              <!-- Resumen del Paciente y Servicio -->
                              <div class="card bg-light border-0 mb-3 p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                  <span class="fs-8 text-secondary text-uppercase fw-semibold">Paciente</span>
                                  <span class="badge bg-secondary-subtle text-secondary font-monospace"><%= c.paciente_identificacion || 'S/D' %></span>
                                </div>
                                <h6 class="fw-bold text-dark mb-1"><%= c.paciente_nombre %> <%= c.paciente_apellido %></h6>
                                <div class="fs-8 text-muted mb-2"><i class="bi bi-clipboard2-pulse me-1"></i>Servicio: <%= c.servicio_nombre || 'Consulta Médica' %></div>
                                
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top fs-8">
                                  <span>ARS: <strong><%= c.ars_nombre || 'Particular' %></strong></span>
                                  <span>Cobertura: <strong class="text-success">- RD$ <%= parseFloat(c.valor_cubierto_ars || 0).toLocaleString('es-DO', { minimumFractionDigits: 2 }) %></strong></span>
                                </div>
                              </div>

                              <!-- Monto del Copago -->
                              <div class="text-center py-2 px-3 rounded-3 bg-danger-subtle border border-danger-subtle mb-4">
                                <span class="fs-8 text-danger text-uppercase fw-bold d-block">Monto a Cobrar al Paciente (Copago)</span>
                                <div class="display-6 fw-bold text-danger my-1">
                                  RD$ <%= parseFloat(c.diferencia_paciente || 0).toLocaleString('es-DO', { minimumFractionDigits: 2 }) %>
                                </div>
                                <small class="text-muted">Total facturado: RD$ <%= parseFloat(c.valor_total || 0).toLocaleString('es-DO', { minimumFractionDigits: 2 }) %></small>
                              </div>

                              <!-- Método de Pago -->
                              <div class="mb-3">
                                <label class="form-label fw-bold fs-7">Seleccione el Método de Pago:</label>
                                <div class="d-flex flex-column gap-2">
                                  <div class="form-check p-3 rounded-3 border bg-white">
                                    <input class="form-check-input" type="radio" name="metodo_pago" id="pagoEf<%= c.consulta_id %>" value="Efectivo" checked>
                                    <label class="form-check-label fw-semibold text-dark w-100" for="pagoEf<%= c.consulta_id %>">
                                      <i class="bi bi-cash text-success me-2 fs-5"></i> Efectivo en Caja
                                    </label>
                                  </div>
                                  <div class="form-check p-3 rounded-3 border bg-white">
                                    <input class="form-check-input" type="radio" name="metodo_pago" id="pagoTarj<%= c.consulta_id %>" value="Tarjeta de Débito / Crédito">
                                    <label class="form-check-label fw-semibold text-dark w-100" for="pagoTarj<%= c.consulta_id %>">
                                      <i class="bi bi-credit-card text-primary me-2 fs-5"></i> Tarjeta de Débito / Crédito (POS)
                                    </label>
                                  </div>
                                  <div class="form-check p-3 rounded-3 border bg-white">
                                    <input class="form-check-input" type="radio" name="metodo_pago" id="pagoTransf<%= c.consulta_id %>" value="Transferencia Bancaria">
                                    <label class="form-check-label fw-semibold text-dark w-100" for="pagoTransf<%= c.consulta_id %>">
                                      <i class="bi bi-bank text-info me-2 fs-5"></i> Transferencia Bancaria
                                    </label>
                                  </div>
                                </div>
                              </div>

                              <!-- Opción PayPal Sandbox -->
                              <div class="alert alert-light border shadow-sm p-3 mb-0 fs-8">
                                <div class="d-flex align-items-center justify-content-between">
                                  <div>
                                    <strong class="text-primary"><i class="bi bi-paypal me-1"></i>¿Pago con PayPal Sandbox?</strong>
                                    <div class="text-muted">Si el paciente prefiere pagar su copago en línea con cuenta PayPal de prueba:</div>
                                  </div>
                                  <a href="/ecf/factura/<%= c.consulta_id %>#seccion-cobro-paypal" class="btn btn-sm btn-outline-primary fw-semibold ms-2">
                                    Ir a PayPal
                                  </a>
                                </div>
                              </div>
                            </div>
                            <div class="modal-footer bg-light">
                              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                              <button type="submit" class="btn btn-success fw-bold px-4">
                                <i class="bi bi-check2-circle me-1"></i> Confirmar Cobro y Marcar Pagado
                              </button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                    <!-- MODAL DE AJUSTAR LIQUIDACIÓN -->
                    <div class="modal fade text-start" id="modalAjustar<%= c.consulta_id %>" tabindex="-1" aria-labelledby="modalAjustarLabel<%= c.consulta_id %>" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                          <form method="POST" action="/ars/cobrar/<%= c.consulta_id %>/liquidar">
                            <input type="hidden" name="return_to" value="/ars/cobrar?estado=<%= filtroEstado %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">
                            <div class="modal-header bg-dark text-white">
                              <h5 class="modal-title fw-bold" id="modalAjustarLabel<%= c.consulta_id %>">
                                <i class="bi bi-shield-check text-warning me-2"></i>Ajustar Liquidación y ARS
                              </h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                              <p class="fs-8 text-secondary mb-3">
                                Seleccione el servicio y aseguradora del paciente. Los montos se recalcularán automáticamente en el servidor según las tarifas pactadas vigentes.
                              </p>
                              <div class="mb-3">
                                <label class="form-label fw-bold fs-7">Servicio Prestado</label>
                                <select name="servicio_id" class="form-select" required>
                                  <% if (servicios && servicios.length > 0) { %>
                                    <% servicios.forEach(function(s) { %>
                                      <option value="<%= s.id %>" <%= c.servicio_id == s.id ? 'selected' : '' %>>
                                        <%= s.nombre %> (Base: RD$ <%= parseFloat(s.precio_base).toFixed(2) %>)
                                      </option>
                                    <% }); %>
                                  <% } %>
                                </select>
                              </div>
                              <div class="mb-3">
                                <label class="form-label fw-bold fs-7">ARS / Seguro Médico</label>
                                <select name="ars_id" class="form-select">
                                  <option value="0" <%= !c.ars_id ? 'selected' : '' %>>Particular (Sin Seguro)</option>
                                  <% if (arsList && arsList.length > 0) { %>
                                    <% arsList.forEach(function(a) { %>
                                      <option value="<%= a.id %>" <%= c.ars_id == a.id ? 'selected' : '' %>>
                                        <%= a.nombre %>
                                      </option>
                                    <% }); %>
                                  <% } %>
                                </select>
                              </div>
                            </div>
                            <div class="modal-footer bg-light">
                              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                              <button type="submit" class="btn btn-teal fw-bold">
                                <i class="bi bi-arrow-repeat me-1"></i> Recalcular y Actualizar Liquidación
                              </button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center py-5">
                <div class="text-muted">
                  <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                  <% if (filtroEstado === 'Pendiente') { %>
                    <h6 class="fw-bold text-dark">No hay cobros pendientes en este momento</h6>
                    <p class="fs-8 mb-3">Cuando el médico finalice una consulta médica y emita la receta, el cargo aparecerá automáticamente aquí para que Secretaría cobre al paciente.</p>
                    <a href="/citas/sala-espera" class="btn btn-sm btn-outline-teal">
                      <i class="bi bi-bell me-1"></i> Ver Sala de Espera
                    </a>
                  <% } else if (filtroEstado === 'Pagado') { %>
                    <h6 class="fw-bold text-dark">No se encontraron pagos registrados con los filtros actuales</h6>
                  <% } else { %>
                    <h6 class="fw-bold text-dark">No se encontraron consultas registradas</h6>
                  <% } %>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

