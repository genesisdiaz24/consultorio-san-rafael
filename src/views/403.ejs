<%- include('partials/header') %>

<% const usuario = (typeof usuarioActual !== 'undefined' && usuarioActual) ? usuarioActual : null; %>

<div class="row justify-content-center py-5">
  <div class="col-12 col-md-8 col-lg-6 text-center">
    <div class="display-1 fw-bold text-danger mb-2">403</div>
    <div class="d-inline-flex p-3 rounded-circle bg-danger-subtle text-danger mb-3">
      <i class="bi bi-shield-slash fs-1"></i>
    </div>
    <h2 class="h4 fw-bold text-dark mb-2">Acceso Denegado &bull; Permisos Insuficientes</h2>
    <p class="text-secondary mb-4">
      <%= typeof mensaje !== 'undefined' ? mensaje : 'Su rol de usuario no tiene autorización para acceder o modificar esta sección del sistema.' %>
    </p>

    <div class="p-3 bg-light border rounded-3 mb-4 text-start fs-7">
      <div class="mb-1"><strong>Usuario conectado:</strong> <%= usuario ? usuario.nombre : 'Desconocido' %></div>
      <div class="mb-1"><strong>Rol asignado:</strong> <span class="badge bg-dark"><%= usuario ? usuario.rol : 'Sin rol' %></span></div>
      <small class="text-muted">Si considera que requiere acceso a este módulo para sus funciones clínicas, solicite al Administrador del sistema la actualización de su perfil.</small>
    </div>

    <a href="/" class="btn btn-teal fw-semibold">
      <i class="bi bi-house-door me-1"></i> Regresar al Panel Principal
    </a>
  </div>
</div>

<%- include('partials/footer') %>
