<%- include('../partials/header') %>

<%
  const esAdmin = usuarioActual && usuarioActual.rol === 'ADMINISTRADOR';
%>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-receipt-cutoff text-teal me-2"></i>Facturación y Comprobantes Fiscales (e-CF)
    </h1>
    <p class="text-muted mb-0">
      <%= esAdmin ? 'Panel de supervisión y gestión fiscal ante la DGII vía API.' : 'Gestión de facturas y emisión de comprobantes fiscales de servicios médicos facturados.' %>
    </p>
  </div>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <% if (configImecf.ambienteConfigurado !== 'eCF') { %>
      <span class="badge bg-light text-secondary border px-3 py-2">
        <i class="bi bi-shield-exclamation me-1"></i>Ambiente de pruebas; no válido para uso fiscal real
      </span>
    <% } else { %>
      <span class="badge bg-danger text-white px-3 py-2">Producción (eCF)</span>
    <% } %>
  </div>
</div>

<% if (!configImecf.tieneApiKey) { %>
  <% if (esAdmin) { %>
    <div class="alert alert-warning border-warning shadow-sm mb-4">
      <div class="d-flex align-items-center gap-2 fw-bold text-dark mb-1">
        <i class="bi bi-gear-fill fs-5 text-warning"></i>
        <span>Configuración técnica de Administración pendiente</span>
      </div>
      <p class="mb-0 fs-8 text-secondary">
        La clave de integración no está configurada en las variables de entorno del servidor. Configure las variables del servidor para habilitar la transmisión de comprobantes.
      </p>
    </div>
  <% } else { %>
    <div class="alert alert-secondary border shadow-sm mb-4">
      <i class="bi bi-info-circle me-1"></i>La integración de comprobantes está pendiente de configuración. Contacte al administrador.
    </div>
  <% } %>
<% } %>

<!-- Filtros de búsqueda -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <form action="/ecf" method="GET" class="row g-2 align-items-center">
      <div class="col-12 col-md-8">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
          <input
            type="text"
            name="q"
            value="<%= q %>"
            class="form-control border-start-0"
            placeholder="Buscar por paciente, cédula/RNC o número de eNCF..."
          >
        </div>
      </div>
      <div class="col-12 col-md-4">
        <select name="estado_ecf" class="form-select" onchange="this.form.submit()" aria-label="Filtrar por estado del e-CF">
          <option value="" <%= !estado_ecf ? 'selected' : '' %>>Todos los estados e-CF</option>
          <option value="SIN_EMITIR" <%= estado_ecf === 'SIN_EMITIR' ? 'selected' : '' %>>Sin emitir</option>
          <option value="Aceptado" <%= estado_ecf === 'Aceptado' ? 'selected' : '' %>>Aceptado DGII</option>
          <option value="AceptadoCondicional" <%= estado_ecf === 'AceptadoCondicional' ? 'selected' : '' %>>Aceptado Condicional DGII</option>
          <option value="PENDIENTE_ENVIO_AL_SERVICIO_DGII" <%= estado_ecf === 'PENDIENTE_ENVIO_AL_SERVICIO_DGII' ? 'selected' : '' %>>Pendiente envío DGII (IMECF)</option>
          <option value="INCIERTO_TIMEOUT" <%= estado_ecf === 'INCIERTO_TIMEOUT' ? 'selected' : '' %>>Incierto (Timeout)</option>
          <option value="Rechazado" <%= estado_ecf === 'Rechazado' ? 'selected' : '' %>>Rechazado</option>
        </select>
      </div>
    </form>
  </div>
</div>

<!-- Tabla de Facturas y Estado e-CF -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Factura</th>
            <th>Fecha</th>
            <th>Paciente / Comprador</th>
            <th>Servicio Facturado</th>
            <th>Liquidación</th>
            <th>eNCF / Tipo</th>
            <th>Estado Real API / DGII</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (facturas && facturas.length > 0) { %>
            <% facturas.forEach(function(f) { %>
              <tr>
                <td class="fw-bold text-dark">#<%= f.consulta_id %></td>
                <td>
                  <span class="fw-semibold text-dark"><%= formatoFecha(f.fecha_consulta) %></span>
                </td>
                <td>
                  <div class="fw-semibold text-dark"><%= f.paciente_nombre %> <%= f.paciente_apellido %></div>
                  <div class="fs-8 text-muted font-monospace"><%= f.paciente_identificacion %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= f.servicio_nombre || 'Consulta Médica General' %></span>
                  <div class="fs-8 text-muted"><%= f.ars_nombre || 'Particular' %></div>
                </td>
                <td>
                  <div class="fs-8">
                    <span class="text-muted">Total:</span> <strong><%= formatoMoneda(f.valor_total) %></strong>
                  </div>
                  <div class="fs-8 text-teal">
                    <span>Copago:</span> <strong><%= formatoMoneda(f.diferencia_paciente) %></strong>
                  </div>
                </td>
                <td>
                  <% if (f.encf) { %>
                    <span class="font-monospace fw-bold text-dark"><%= f.encf %></span>
                    <span class="badge bg-teal ms-1"><%= f.tipo_ecf %></span>
                  <% } else if (f.ecf_local_id) { %>
                    <span class="badge bg-secondary"><%= f.tipo_ecf %></span>
                  <% } else { %>
                    <span class="text-muted fs-8">No emitido</span>
                  <% } %>
                </td>
                <td>
                  <% if (f.estadoInfo) { %>
                    <span class="badge <%= f.estadoInfo.claseBadge %>">
                      <i class="bi <%= f.estadoInfo.icono %> me-1"></i><%= f.estadoInfo.etiqueta %>
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-secondary border">Pendiente de Emisión</span>
                  <% } %>
                </td>
                <td class="text-end text-nowrap">
                  <% const facturaEmitida = Boolean(f.encf) && !(f.estadoInfo && f.estadoInfo.esError); %>
                  <% if (facturaEmitida) { %>
                    <a href="/ecf/factura/<%= f.consulta_id %>" class="btn btn-sm btn-outline-teal fw-semibold">
                      <i class="bi bi-file-earmark-text me-1"></i> Ver factura
                    </a>
                  <% } else if (configImecf.tieneApiKey) { %>
                    <a href="/ecf/factura/<%= f.consulta_id %>#panel-ecf-imecf" class="btn btn-sm btn-teal fw-semibold">
                      <i class="bi bi-cloud-upload me-1"></i> Emitir e-CF
                    </a>
                  <% } else { %>
                    <button type="button" class="btn btn-sm btn-secondary" disabled title="La emisión de comprobantes no está configurada. Contacte al administrador.">
                      <i class="bi bi-cloud-upload me-1"></i> Emitir e-CF
                    </button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="bi bi-receipt fs-1 d-block mb-2 text-teal-light"></i>
                <h6 class="fw-bold text-dark">No se encontraron facturas para los criterios seleccionados</h6>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
