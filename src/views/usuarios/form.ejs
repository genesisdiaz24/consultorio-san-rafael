<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 fw-bold text-dark mb-1">
          <i class="bi bi-person-plus-fill text-teal me-2"></i>Crear Nuevo Usuario
        </h1>
        <p class="text-muted mb-0">Registre un miembro del equipo médico o administrativo y asígnele su rol correspondiente.</p>
      </div>
      <a href="/usuarios" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver a usuarios
      </a>
    </div>

    <form action="/usuarios" method="POST" class="needs-validation" novalidate>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-12">
              <label for="nombre" class="form-label fs-7 fw-semibold">Nombre y Apellidos <span class="text-danger">*</span></label>
              <input type="text" name="nombre" id="nombre" class="form-control" placeholder="Ej: Dr. Manuel Santos / Lic. Ana Valdez" required>
            </div>

            <div class="col-12 col-md-6">
              <label for="usuario" class="form-label fs-7 fw-semibold">Nombre de Usuario (Login) <span class="text-danger">*</span></label>
              <input type="text" name="usuario" id="usuario" class="form-control font-monospace" placeholder="Ej: msantos" required>
            </div>

            <div class="col-12 col-md-6">
              <label for="correo" class="form-label fs-7 fw-semibold">Correo Electrónico</label>
              <input type="email" name="correo" id="correo" class="form-control" placeholder="msantos@sanrafael.com">
            </div>

            <div class="col-12 col-md-6">
              <label for="contrasena" class="form-label fs-7 fw-semibold">Contraseña Inicial <span class="text-danger">*</span></label>
              <input type="password" name="contrasena" id="contrasena" class="form-control" placeholder="••••••••" required>
            </div>

            <div class="col-12 col-md-6">
              <label for="rol" class="form-label fs-7 fw-semibold">Rol Asignado <span class="text-danger">*</span></label>
              <select name="rol" id="rol" class="form-select" required>
                <option value="">Seleccione rol...</option>
                <option value="ADMINISTRADOR">ADMINISTRADOR (Acceso total al sistema)</option>
                <option value="MEDICO">MÉDICO (Pacientes, Citas, Consultas, Recetas)</option>
                <option value="SECRETARIA">SECRETARÍA (Pacientes, Citas, ARS y Cobros)</option>
                <option value="FARMACIA">FARMACIA (Inventario y Despacho de recetas)</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2 mb-5">
        <a href="/usuarios" class="btn btn-outline-secondary px-4">Cancelar</a>
        <button type="submit" class="btn btn-teal fw-semibold px-5 shadow-sm">
          <i class="bi bi-save me-1"></i> Guardar Usuario
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
