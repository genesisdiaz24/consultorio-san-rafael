<%- include('../partials/header') %>
<% const esAdminCob = usuarioActual && usuarioActual.rol === 'ADMINISTRADOR'; %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-shield-plus text-teal me-2"></i>Cobertura ARS: <span class="text-teal"><%= medicamento.nombre %></span>
    </h1>
    <p class="text-muted mb-0">
      <span class="font-monospace"><%= medicamento.codigo %></span> &bull; <%= medicamento.presentacion %><%= medicamento.concentracion ? ' ' + medicamento.concentracion : '' %>
      <% if (!esAdminCob) { %>&bull; <i class="bi bi-eye me-1"></i>Solo lectura: solo el Administrador puede modificar precios y coberturas.<% } %>
    </p>
  </div>
  <a href="/farmacia/inventario" class="btn btn-outline-teal fw-semibold text-nowrap">
    <i class="bi bi-arrow-left me-1"></i> Volver al inventario
  </a>
</div>

<div class="row g-4">
  <div class="col-12 <%= esAdminCob ? 'col-lg-7' : '' %>">
    <!-- Precio -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <span class="fs-8 text-secondary text-uppercase fw-semibold d-block">Precio por unidad</span>
          <div class="fs-4 fw-bold text-dark"><%= formatoMoneda(medicamento.precio_unitario) %></div>
          <% if (Number(medicamento.precio_unitario) === 0) { %>
            <small class="text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>Sin precio: al despacharlo el costo será RD$ 0.00.</small>
          <% } %>
        </div>
        <% if (esAdminCob) { %>
          <form action="/farmacia/inventario/<%= medicamento.id %>/precio" method="POST" class="d-flex gap-2 align-items-end">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div>
              <label for="precio_unitario" class="form-label fs-8 fw-semibold mb-1">Nuevo precio (RD$)</label>
              <input type="number" step="0.01" min="0" name="precio_unitario" id="precio_unitario" class="form-control form-control-sm" value="<%= Number(medicamento.precio_unitario).toFixed(2) %>" required>
            </div>
            <button type="submit" class="btn btn-sm btn-outline-teal fw-semibold"><i class="bi bi-save me-1"></i> Guardar precio</button>
          </form>
        <% } %>
      </div>
    </div>

    <!-- Coberturas configuradas -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-check text-teal me-2"></i>ARS que cubren este medicamento</h5>
        <small class="text-muted">Las ARS que no aparecen aquí <strong>no lo cubren</strong>: sus afiliados pagan el 100%.</small>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light fs-8 text-uppercase">
              <tr>
                <th>ARS</th>
                <th class="text-center">% Cobertura</th>
                <th>Ejemplo por 1 unidad</th>
                <% if (esAdminCob) { %><th class="text-end">Acción</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% if (coberturas.length > 0) { %>
                <% coberturas.forEach(function(c) {
                     const precio = Number(medicamento.precio_unitario) || 0;
                     const cubre = Math.round(precio * Number(c.porcentaje_cobertura)) / 100; %>
                  <tr>
                    <td>
                      <strong class="text-dark"><%= c.ars_nombre %></strong>
                      <% if (c.ars_activo === false) { %><span class="badge bg-secondary ms-1">ARS desactivada</span><% } %>
                    </td>
                    <td class="text-center"><span class="badge bg-teal fs-7"><%= Number(c.porcentaje_cobertura) %>%</span></td>
                    <td class="fs-8">
                      ARS paga <strong class="text-teal"><%= formatoMoneda(cubre) %></strong> &bull;
                      Paciente paga <strong class="text-danger"><%= formatoMoneda(precio - cubre) %></strong>
                    </td>
                    <% if (esAdminCob) { %>
                      <td class="text-end">
                        <form action="/farmacia/inventario/<%= medicamento.id %>/coberturas/<%= c.id %>/eliminar" method="POST" class="d-inline" onsubmit="return confirm('¿Quitar la cobertura de <%= c.ars_nombre %> para este medicamento?');">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Quitar cobertura"><i class="bi bi-trash"></i></button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="<%= esAdminCob ? 4 : 3 %>" class="text-center py-4 text-muted">
                    <i class="bi bi-shield-x fs-3 d-block mb-1"></i>Ninguna ARS cubre este medicamento: todos los pacientes pagan el 100%.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <% if (esAdminCob) { %>
    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-0">
          <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-plus-circle text-teal me-2"></i>Agregar o modificar cobertura</h5>
        </div>
        <div class="card-body p-4 pt-0">
          <form action="/farmacia/inventario/<%= medicamento.id %>/coberturas" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label for="ars_id" class="form-label fw-semibold fs-7">ARS <span class="text-danger">*</span></label>
              <select name="ars_id" id="ars_id" class="form-select" required>
                <option value="">Seleccione la ARS...</option>
                <% arsDisponibles.forEach(function(a) { %>
                  <option value="<%= a.id %>"><%= a.nombre %></option>
                <% }); %>
              </select>
              <small class="text-muted fs-8">Si la ARS ya tiene cobertura, se actualiza el porcentaje.</small>
            </div>
            <div class="mb-3">
              <label for="porcentaje_cobertura" class="form-label fw-semibold fs-7">Porcentaje que cubre la ARS (%) <span class="text-danger">*</span></label>
              <input type="number" step="0.01" min="0.01" max="100" name="porcentaje_cobertura" id="porcentaje_cobertura" class="form-control" placeholder="Ej: 80" required>
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-teal fw-semibold"><i class="bi bi-save me-1"></i> Guardar cobertura</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
