<%- include('../partials/header') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-capsule-pill text-teal me-2"></i>Dispensación de Recetas Médicas
    </h1>
    <p class="text-muted mb-0">
      Búsqueda de pacientes, consulta de recetas médicas y registro de medicamentos entregados o no entregados con control de inventario.
    </p>
  </div>
  <div class="d-flex gap-2">
    <a href="/farmacia/chat" class="btn btn-teal fw-semibold shadow-sm">
      <i class="bi bi-robot me-1"></i> Asistente IA
    </a>
    <a href="/farmacia/inventario" class="btn btn-outline-teal fw-semibold">
      <i class="bi bi-boxes me-1"></i> Control de Inventario
    </a>
    <a href="/farmacia/movimientos" class="btn btn-light border fw-semibold">
      <i class="bi bi-clock-history me-1"></i> Auditoría de Movimientos
    </a>
  </div>
</div>

<!-- Tarjetas de Métricas de Farmacia -->
<div class="row g-3 mb-4">
  <div class="col-12 col-sm-4">
    <div class="card card-stat border-0 shadow-sm border-start border-4 border-warning h-100">
      <div class="card-body d-flex align-items-center justify-content-between p-3">
        <div>
          <span class="text-muted text-uppercase fs-8 fw-semibold">Recetas Pendientes</span>
          <h2 class="fw-bold mb-0 text-dark"><%= stats.recetas_pendientes_count || 0 %></h2>
          <small class="text-warning fw-semibold">
            <i class="bi bi-hourglass-split me-1"></i>Por despachar a pacientes
          </small>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
          <i class="bi bi-prescription fs-3"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-4">
    <div class="card card-stat border-0 shadow-sm border-start border-4 border-success h-100">
      <div class="card-body d-flex align-items-center justify-content-between p-3">
        <div>
          <span class="text-muted text-uppercase fs-8 fw-semibold">Entregados Hoy</span>
          <h2 class="fw-bold mb-0 text-success"><%= stats.items_entregados_hoy || 0 %></h2>
          <small class="text-success fw-semibold">
            <i class="bi bi-check2-circle me-1"></i>Unidades entregadas
          </small>
        </div>
        <div class="stat-icon bg-success-subtle text-success">
          <i class="bi bi-box2-heart fs-3"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-4">
    <div class="card card-stat border-0 shadow-sm border-start border-4 border-danger h-100">
      <div class="card-body d-flex align-items-center justify-content-between p-3">
        <div>
          <span class="text-muted text-uppercase fs-8 fw-semibold">No Entregados / Sin Stock Hoy</span>
          <h2 class="fw-bold mb-0 text-danger"><%= stats.items_no_entregados_hoy || 0 %></h2>
          <small class="text-danger fw-semibold">
            <i class="bi bi-exclamation-octagon me-1"></i>Derivados a compra externa
          </small>
        </div>
        <div class="stat-icon bg-danger-subtle text-danger">
          <i class="bi bi-x-circle fs-3"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filtros y Barra de Búsqueda de Pacientes por Nombre o Cédula -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-3">
    <div class="row g-3 align-items-center">
      <!-- Pestañas de Estado -->
      <div class="col-12 col-md-5">
        <div class="nav nav-pills gap-1">
          <a href="/farmacia/dispensar?estado=pendientes<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
             class="btn btn-sm <%= filtroEstado === 'pendientes' ? 'btn-warning text-dark fw-bold' : 'btn-light border' %>">
            <i class="bi bi-clock-history me-1"></i> Pendientes
            <span class="badge bg-dark text-white ms-1"><%= stats.recetas_pendientes_count || 0 %></span>
          </a>
          <a href="/farmacia/dispensar?estado=completadas<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
             class="btn btn-sm <%= filtroEstado === 'completadas' ? 'btn-success fw-bold' : 'btn-light border' %>">
            <i class="bi bi-check-circle me-1"></i> Despachadas
          </a>
          <a href="/farmacia/dispensar?estado=todas<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
             class="btn btn-sm <%= filtroEstado === 'todas' ? 'btn-teal fw-bold' : 'btn-light border' %>">
            <i class="bi bi-list-ul me-1"></i> Todas
          </a>
        </div>
      </div>

      <!-- Buscador de Pacientes por Nombre o Cédula -->
      <div class="col-12 col-md-7">
        <form method="GET" action="/farmacia/dispensar" class="d-flex gap-2">
          <input type="hidden" name="estado" value="<%= filtroEstado %>">
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text"
                   name="q"
                   class="form-control border-start-0"
                   placeholder="Buscar paciente por nombre o cédula, o código de receta..."
                   value="<%= q %>">
            <% if (q) { %>
              <a href="/farmacia/dispensar?estado=<%= filtroEstado %>" class="btn btn-outline-secondary" title="Limpiar búsqueda">
                <i class="bi bi-x-lg"></i>
              </a>
            <% } %>
            <button class="btn btn-teal" type="submit">Buscar Paciente</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Listado de Recetas -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h5 class="fw-bold mb-0 text-dark">
        <i class="bi bi-receipt-cutoff text-teal me-2"></i>
        <% if (filtroEstado === 'pendientes') { %>
          Recetas Médicas con Fármacos Pendientes de Despacho
        <% } else if (filtroEstado === 'completadas') { %>
          Recetas Médicas Despachadas Completamente
        <% } else { %>
          Todas las Recetas Médicas Registradas
        <% } %>
      </h5>
      <small class="text-muted">
        Consulte las prescripciones médicas, verifique existencias en farmacia interna y registre la entrega o no entrega.
      </small>
    </div>
    <span class="badge bg-light text-dark border">
      <%= recetas.length %> receta(s)
    </span>
  </div>

  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light fs-8 text-uppercase">
          <tr>
            <th>Código Receta / Fecha</th>
            <th>Paciente &amp; Cédula</th>
            <th>Seguro / ARS</th>
            <th>Fármacos Recetados</th>
            <th>Estado de Dispensación</th>
            <th class="text-end">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% if (recetas && recetas.length > 0) { %>
            <% recetas.forEach(function(r) { %>
              <% const tienePendientes = parseInt(r.pendientes, 10) > 0; %>
              <tr class="<%= tienePendientes ? 'table-warning-subtle' : '' %>">
                <td>
                  <a href="/farmacia/dispensar/<%= r.receta_id %>" class="fw-bold font-monospace text-teal text-decoration-none">
                    <%= r.codigo_receta %>
                  </a>
                  <small class="d-block text-muted">
                    <%= new Date(r.fecha_emision).toLocaleDateString('es-DO', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </small>
                </td>
                <td>
                  <div class="fw-bold text-dark"><%= r.paciente_nombre %> <%= r.paciente_apellido %></div>
                  <div class="fs-8 text-muted font-monospace"><%= r.paciente_identificacion %></div>
                  <% if (r.paciente_telefono) { %>
                    <small class="text-secondary"><i class="bi bi-telephone me-1"></i><%= r.paciente_telefono %></small>
                  <% } %>
                </td>
                <td>
                  <% if (r.ars_nombre) { %>
                    <span class="badge bg-teal-subtle text-teal border border-teal-subtle">
                      <i class="bi bi-shield-check me-1"></i><%= r.ars_nombre %>
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary">
                      Particular (Sin ARS)
                    </span>
                  <% } %>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <i class="bi bi-capsule me-1"></i><%= r.total_items %> medicamento(s)
                  </span>
                  <% if (r.diagnostico_clinico) { %>
                    <small class="d-block text-muted text-truncate" style="max-width: 220px;" title="<%= r.diagnostico_clinico %>">
                      Dx: <%= r.diagnostico_clinico %>
                    </small>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex flex-wrap gap-1">
                    <% if (r.pendientes > 0) { %>
                      <span class="badge bg-warning text-dark">
                        <i class="bi bi-hourglass-split me-1"></i> <%= r.pendientes %> Pendiente(s)
                      </span>
                    <% } %>
                    <% if (r.entregados > 0) { %>
                      <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i> <%= r.entregados %> Entregado(s)
                      </span>
                    <% } %>
                    <% if (r.no_entregados > 0) { %>
                      <span class="badge bg-danger">
                        <i class="bi bi-x-circle me-1"></i> <%= r.no_entregados %> No entregado(s)
                      </span>
                    <% } %>
                  </div>
                </td>
                <td class="text-end">
                  <a href="/farmacia/dispensar/<%= r.receta_id %>" class="btn btn-sm <%= tienePendientes ? 'btn-teal fw-bold shadow-sm' : 'btn-outline-secondary' %>">
                    <i class="bi bi-box-seam me-1"></i> <%= tienePendientes ? 'Despachar Receta' : 'Ver Detalle' %>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-file-earmark-medical fs-1 d-block mb-2 text-teal-light"></i>
                <h6 class="fw-bold text-dark">No se encontraron recetas médicas con los filtros indicados</h6>
                <p class="mb-0 fs-8">
                  <% if (q) { %>
                    No hay resultados para la búsqueda "<strong><%= q %></strong>". Intente con otro nombre o cédula.
                  <% } else { %>
                    Cuando el médico prescriba recetas durante la consulta, aparecerán en esta cola para su entrega.
                  <% } %>
                </p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
