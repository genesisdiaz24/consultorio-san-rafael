<%- include('partials/header') %>

<% if (rol === 'MEDICO') { %>
  <!-- ======================================================== -->
  <!-- 🩺 PANEL EXCLUSIVO PARA ROL MÉDICO                      -->
  <!-- ======================================================== -->
  <div class="mb-4">
    <h1 class="h3 fw-bold text-dark mb-1">
      <i class="bi bi-stethoscope text-teal me-2"></i>Panel Médico y Atención Clínica
    </h1>
    <p class="text-muted mb-0">Pacientes en espera y agenda del día.</p>
  </div>

  <!-- Aviso: solo si hay pacientes esperando -->
  <% if (enEsperaList && enEsperaList.length > 0) { %>
    <div class="alert alert-warning border-warning shadow-sm mb-4 p-3 animate-pulse">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
          <span class="badge bg-danger p-2 fs-6 rounded-circle">
            <i class="bi bi-bell-fill"></i>
          </span>
          <div>
            <h5 class="alert-heading mb-1 fw-bold text-dark">
              ¡Aviso Médico! Hay <%= enEsperaList.length %> paciente(s) esperando en Sala de Espera
            </h5>
            <p class="mb-0 text-secondary fs-7">
              Siguiente: <strong><%= enEsperaList[0].paciente_nombre %> <%= enEsperaList[0].paciente_apellido %></strong> &bull; Espera: <%= enEsperaList[0].minutos_espera || 0 %> min.
            </p>
          </div>
        </div>
        <div class="d-flex gap-2">
          <a href="/consultas/atender?paciente_id=<%= enEsperaList[0].paciente_id %>&cita_id=<%= enEsperaList[0].id %>" class="btn btn-success fw-bold shadow-sm">
            <i class="bi bi-stethoscope me-1"></i> Iniciar Consulta Ahora
          </a>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Indicadores del día -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-warning h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">En Sala de Espera</span>
            <h2 class="fw-bold mb-0 text-dark"><%= enEsperaList.length %></h2>
            <small class="text-warning"><i class="bi bi-hourglass-split me-1"></i>Listos para atender</small>
          </div>
          <div class="stat-icon bg-warning-subtle text-warning">
            <i class="bi bi-person-walking"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-4">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-primary h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Citas de Hoy</span>
            <h2 class="fw-bold mb-0 text-dark"><%= citasHoy %></h2>
            <small class="text-primary"><i class="bi bi-calendar3 me-1"></i>Agendadas para hoy</small>
          </div>
          <div class="stat-icon bg-primary-subtle text-primary">
            <i class="bi bi-calendar2-week-fill"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-4">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-success h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Atendidos Hoy</span>
            <h2 class="fw-bold mb-0 text-dark"><%= atendidosHoy %></h2>
            <small class="text-success"><i class="bi bi-calendar-check me-1"></i>Consultas realizadas hoy</small>
          </div>
          <div class="stat-icon bg-success-subtle text-success">
            <i class="bi bi-clipboard2-check-fill"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Accesos Rápidos del Médico -->
  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <h6 class="fw-bold text-secondary mb-3 text-uppercase fs-8">Operaciones Médicas</h6>
          <div class="row g-2">
            <div class="col-6 col-md-3">
              <a href="/citas/sala-espera" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-bell fs-3 text-warning mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Sala de Espera</span>
                <small class="text-muted fs-8">Llamar paciente</small>
              </a>
            </div>
            <div class="col-6 col-md-3">
              <a href="/consultas" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-clipboard2-pulse fs-3 text-success mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Consultas</span>
                <small class="text-muted fs-8">Atenciones realizadas</small>
              </a>
            </div>
            <div class="col-6 col-md-3">
              <a href="/consultas/historial" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-journal-medical fs-3 text-teal mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Historiales</span>
                <small class="text-muted fs-8">Antecedentes pacientes</small>
              </a>
            </div>
            <div class="col-6 col-md-3">
              <a href="/consultas/recetas" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-prescription fs-3 text-primary mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Recetas</span>
                <small class="text-muted fs-8">Prescripciones emitidas</small>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%
    // Color de cada estado de la agenda
    const ESTILO_ESTADO = {
      'Pendiente': 'bg-light text-dark border',
      'En espera': 'bg-warning text-dark',
      'En consulta': 'bg-primary',
      'Atendido': 'bg-success',
      'No asistió': 'bg-danger-subtle text-danger border border-danger',
    };
  %>

  <div class="row g-4">
    <!-- Pacientes en Sala de Espera -->
    <div class="col-12 col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-hourglass-split text-warning me-2"></i>Pacientes Esperando Atención
          </h5>
          <a href="/citas/sala-espera" class="btn btn-sm btn-outline-warning">Ver todos (<%= enEsperaList.length %>)</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light fs-8 text-uppercase">
                <tr>
                  <th>Paciente</th>
                  <th>Espera</th>
                  <th>Alergias</th>
                  <th class="text-end">Acción</th>
                </tr>
              </thead>
              <tbody>
                <% if (enEsperaList && enEsperaList.length > 0) { %>
                  <% enEsperaList.forEach(function(c) { %>
                    <tr>
                      <td>
                        <div class="fw-semibold text-dark"><%= c.paciente_nombre %> <%= c.paciente_apellido %></div>
                        <small class="text-muted font-monospace"><%= c.identificacion %></small>
                      </td>
                      <td class="text-nowrap">
                        <span class="badge bg-warning text-dark"><%= c.minutos_espera || 0 %> min</span>
                      </td>
                      <td>
                        <%- include('partials/alergias', { texto: c.antecedentes_alergicos }) %>
                      </td>
                      <td class="text-end">
                        <a href="/consultas/atender?paciente_id=<%= c.paciente_id %>&cita_id=<%= c.id %>" class="btn btn-sm btn-success fw-semibold text-nowrap">
                          <i class="bi bi-stethoscope me-1"></i>Atender
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-muted">
                      <i class="bi bi-check2-circle fs-3 d-block mb-1 text-success"></i>
                      No hay pacientes en sala de espera en este momento.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Agenda de Hoy -->
    <div class="col-12 col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-calendar3 text-teal me-2"></i>Agenda de Hoy
          </h5>
          <span class="text-muted fs-8"><%= new Date().toLocaleDateString('es-DO', { timeZone: 'America/Santo_Domingo', weekday: 'long', day: 'numeric', month: 'long' }) %></span>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light fs-8 text-uppercase">
                <tr>
                  <th>Hora</th>
                  <th>Paciente</th>
                  <th>Servicio</th>
                  <th class="text-end">Estado</th>
                </tr>
              </thead>
              <tbody>
                <% if (agendaHoy && agendaHoy.length > 0) { %>
                  <% agendaHoy.forEach(function(a) { %>
                    <%
                      const [hh, mm] = String(a.hora).split(':').map(Number);
                      const hora12 = String(((hh + 11) % 12) + 1).padStart(2, '0') + ':' + String(mm).padStart(2, '0') + (hh < 12 ? ' AM' : ' PM');
                    %>
                    <tr>
                      <td class="fw-bold text-teal font-monospace text-nowrap"><%= hora12 %></td>
                      <td class="fw-semibold text-dark"><%= a.paciente_nombre %> <%= a.paciente_apellido %></td>
                      <td class="fs-7 text-secondary"><%= a.servicio_nombre %></td>
                      <td class="text-end text-nowrap">
                        <span class="badge <%= ESTILO_ESTADO[a.estado_medico] %>"><%= a.estado_medico %></span>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-muted">
                      <i class="bi bi-calendar-x fs-3 d-block mb-1"></i>
                      No hay citas programadas para hoy
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
<% } else if (rol === 'SECRETARIA' || rol === 'RECEPCION') { %>
  <!-- ======================================================== -->
  <!-- 📋 PANEL EXCLUSIVO PARA ROL SECRETARÍA                   -->
  <!-- ======================================================== -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">
        <i class="bi bi-calendar2-week-fill text-teal me-2"></i>Panel de Secretaría y Recepción
      </h1>
      <p class="text-muted mb-0">Gestión de pacientes, agenda multicanal de citas, confirmación de llegada y aseguradoras ARS.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/pacientes/nuevo" class="btn btn-outline-teal btn-sm fw-semibold">
        <i class="bi bi-person-plus me-1"></i> Registrar Paciente
      </a>
      <a href="/citas/nueva" class="btn btn-teal btn-sm fw-semibold shadow-sm">
        <i class="bi bi-calendar-plus me-1"></i> Agendar Cita
      </a>
    </div>
  </div>

  <!-- Métricas Rápidas de Secretaría -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-danger h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Cobros Pendientes</span>
            <h2 class="fw-bold mb-0 text-danger"><%= typeof cobrosPendientesCount !== 'undefined' ? cobrosPendientesCount : 0 %></h2>
            <small class="text-danger"><i class="bi bi-cash-coin me-1"></i>Atenciones por cobrar</small>
          </div>
          <div class="stat-icon bg-danger-subtle text-danger">
            <i class="bi bi-receipt-cutoff"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-teal h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Pacientes Registrados</span>
            <h2 class="fw-bold mb-0 text-dark"><%= totalPacientes %></h2>
            <small class="text-teal"><i class="bi bi-people me-1"></i>Con ficha médica</small>
          </div>
          <div class="stat-icon bg-teal-subtle text-teal">
            <i class="bi bi-people-fill"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-primary h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Citas para Hoy</span>
            <h2 class="fw-bold mb-0 text-dark"><%= citasHoy %></h2>
            <small class="text-primary"><i class="bi bi-calendar-event me-1"></i>Agenda del día</small>
          </div>
          <div class="stat-icon bg-primary-subtle text-primary">
            <i class="bi bi-calendar2-week-fill"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-warning h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">En Sala de Espera</span>
            <h2 class="fw-bold mb-0 text-dark"><%= enEsperaCount %></h2>
            <small class="text-warning"><i class="bi bi-hourglass-split me-1"></i>Llegada confirmada</small>
          </div>
          <div class="stat-icon bg-warning-subtle text-warning">
            <i class="bi bi-person-walking"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-info h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Aseguradoras (ARS)</span>
            <h2 class="fw-bold mb-0 text-dark"><%= totalArs %></h2>
            <small class="text-info"><i class="bi bi-shield-check me-1"></i>Coberturas activas</small>
          </div>
          <div class="stat-icon bg-info-subtle text-info">
            <i class="bi bi-building-check"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Accesos Rápidos de Secretaría -->
  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <h6 class="fw-bold text-secondary mb-3 text-uppercase fs-8">Procesos de Recepción</h6>
          <div class="row g-2">
            <div class="col-6 col-md-3">
              <a href="/pacientes/nuevo" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-person-plus fs-3 text-teal mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Nuevo Paciente</span>
                <small class="text-muted fs-8">Ficha anti-duplicados</small>
              </a>
            </div>
            <div class="col-6 col-md-3">
              <a href="/citas/nueva" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-telephone-inbound fs-3 text-primary mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Agendar Cita</span>
                <small class="text-muted fs-8">Tel / Chat / Presencial</small>
              </a>
            </div>
            <div class="col-6 col-md-3">
              <a href="/citas/sala-espera" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-bell fs-3 text-warning mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Sala de Espera</span>
                <small class="text-muted fs-8">Confirmar llegadas</small>
              </a>
            </div>
            <div class="col-6 col-md-3">
              <a href="/ars/calcular" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-calculator fs-3 text-success mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Simulador Copago</span>
                <small class="text-muted fs-8">Calcular cobertura ARS</small>
              </a>
            </div>
            <div class="col-12 col-md-12 col-lg-12">
              <a href="/ecf" class="btn btn-light border w-100 d-flex align-items-center justify-content-between p-3 text-decoration-none hover-shadow">
                <div class="d-flex align-items-center gap-3">
                  <div class="rounded-circle bg-danger-subtle text-danger p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="bi bi-receipt-cutoff fs-4"></i>
                  </div>
                  <div>
                    <h6 class="fw-bold mb-0 text-dark">Módulo de Facturación y Cobros e-CF</h6>
                    <small class="text-muted fs-8">Revisar consultas atendidas, liquidar copago del paciente y registrar cobros en caja o PayPal</small>
                  </div>
                </div>
                <span class="badge bg-danger fs-8 fw-semibold px-3 py-2">
                  <i class="bi bi-cash-coin me-1"></i><%= typeof cobrosPendientesCount !== 'undefined' ? cobrosPendientesCount : 0 %> Pendientes &rarr;
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tablas de Secretaría -->
  <div class="row g-4">
    <!-- Atenciones Médicas Pendientes de Cobro -->
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <h5 class="fw-bold mb-0 text-dark">
              <i class="bi bi-cash-stack text-danger me-2"></i>Consultas Médicas Pendientes de Cobro
            </h5>
            <span class="badge bg-danger-subtle text-danger border border-danger fs-8">
              <%= typeof cobrosPendientesCount !== 'undefined' ? cobrosPendientesCount : 0 %> pendientes
            </span>
          </div>
          <a href="/ars/cobrar" class="btn btn-sm btn-outline-danger fw-semibold">
            <i class="bi bi-cash-coin me-1"></i> Ir a Cobrar Consultas
          </a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light fs-8 text-uppercase">
                <tr>
                  <th>Consulta # / Fecha</th>
                  <th>Paciente</th>
                  <th>Servicio Prestado</th>
                  <th>ARS / Aseguradora</th>
                  <th>Total Factura</th>
                  <th>Copago Paciente</th>
                  <th>Estado</th>
                  <th class="text-end">Acción de Cobro</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof cobrosPendientes !== 'undefined' && cobrosPendientes && cobrosPendientes.length > 0) { %>
                  <% cobrosPendientes.forEach(function(cp) { %>
                    <tr>
                      <td>
                        <span class="fw-bold text-dark font-monospace">#<%= cp.id %></span>
                        <small class="d-block text-muted"><%= formatoFecha(cp.fecha_consulta) %></small>
                      </td>
                      <td>
                        <div class="fw-bold text-dark"><%= cp.paciente_nombre %> <%= cp.paciente_apellido %></div>
                        <small class="text-muted font-monospace"><%= cp.paciente_identificacion %></small>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border"><%= cp.servicio_nombre || 'Consulta Médica' %></span>
                      </td>
                      <td>
                        <% if (cp.ars_nombre) { %>
                          <span class="badge bg-teal-subtle text-teal border border-teal-subtle"><%= cp.ars_nombre %></span>
                          <small class="text-muted d-block">- <%= formatoMoneda(cp.valor_cubierto_ars) %></small>
                        <% } else { %>
                          <span class="badge bg-secondary-subtle text-secondary">Particular</span>
                        <% } %>
                      </td>
                      <td class="fw-semibold text-dark">
                        <%= formatoMoneda(cp.valor_total) %>
                      </td>
                      <td>
                        <span class="fs-6 fw-bold text-danger">
                          <%= formatoMoneda(cp.diferencia_paciente) %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Pendiente</span>
                      </td>
                      <td class="text-end">
                        <a href="/ecf/factura/<%= cp.id %>" class="btn btn-sm btn-primary fw-bold shadow-sm">
                          <i class="bi bi-cash-coin me-1"></i> Revisar y Cobrar
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                      <i class="bi bi-check2-circle fs-3 text-success d-block mb-1"></i>
                      No hay consultas médicas pendientes de cobro en este momento.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <!-- Citas del Día -->
    <div class="col-12 col-lg-7">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-calendar3 text-teal me-2"></i>Agenda y Citas de Hoy
          </h5>
          <a href="/citas" class="btn btn-sm btn-outline-teal">Ver todas</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light fs-8 text-uppercase">
                <tr>
                  <th>Hora</th>
                  <th>Paciente</th>
                  <th>Canal</th>
                  <th>Estado</th>
                  <th class="text-end">Acción</th>
                </tr>
              </thead>
              <tbody>
                <% if (proximasCitas && proximasCitas.length > 0) { %>
                  <% proximasCitas.forEach(function(cita) { %>
                    <tr>
                      <td class="fw-bold text-teal"><%= cita.hora.substring(0, 5) %></td>
                      <td>
                        <div class="fw-semibold"><%= cita.paciente_nombre %> <%= cita.paciente_apellido %></div>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border"><%= cita.canal_solicitud %></span>
                      </td>
                      <td>
                        <% if (cita.estado === 'En sala de espera') { %>
                          <span class="badge bg-warning text-dark"><i class="bi bi-bell-fill me-1"></i>En sala</span>
                        <% } else if (cita.estado === 'Atendida') { %>
                          <span class="badge bg-success">Atendida</span>
                        <% } else { %>
                          <span class="badge bg-primary">Programada</span>
                        <% } %>
                      </td>
                      <td class="text-end">
                        <% if (cita.estado === 'Programada') { %>
                          <form action="/citas/<%= cita.id %>/confirmar-llegada" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Confirmar llegada del paciente">
                              <i class="bi bi-check-lg me-1"></i>Llegó
                            </button>
                          </form>
                        <% } else { %>
                          <span class="text-muted fs-8">Confirmado</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                      No hay citas programadas para hoy.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Pacientes Registrados Recientemente -->
    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-people text-teal me-2"></i>Pacientes Recientes
          </h5>
          <a href="/pacientes" class="btn btn-sm btn-outline-teal">Directorio</a>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <% if (pacientesRecientes && pacientesRecientes.length > 0) { %>
              <% pacientesRecientes.forEach(function(p) { %>
                <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                  <div>
                    <h6 class="mb-0 fw-bold text-dark"><%= p.nombre %> <%= p.apellido %></h6>
                    <small class="text-muted font-monospace"><%= p.identificacion %> &bull; Tel: <%= p.telefono %></small>
                    <div class="fs-8 text-teal"><%= p.ars_nombre || 'Particular / Sin ARS' %></div>
                  </div>
                  <a href="/pacientes/<%= p.id %>" class="btn btn-sm btn-outline-teal">Ficha</a>
                </div>
              <% }); %>
            <% } else { %>
              <div class="text-center py-4 text-muted">
                No hay pacientes registrados recientemente.
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

<% } else if (rol === 'FARMACIA') { %>
  <!-- ======================================================== -->
  <!-- 💊 PANEL EXCLUSIVO PARA ROL FARMACIA                     -->
  <!-- ======================================================== -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">
        <i class="bi bi-capsule-pill text-teal me-2"></i>Panel de Farmacia Interna
      </h1>
      <p class="text-muted mb-0">Dispensación de recetas médicas recibidas, verificación de stock y control de existencias.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/farmacia/dispensar" class="btn btn-teal btn-sm fw-semibold shadow-sm">
        <i class="bi bi-check2-circle me-1"></i> Despachar Recetas (<%= recetasPendientesCount %>)
      </a>
    </div>
  </div>

  <!-- Métricas de Farmacia -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-warning h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Recetas Pendientes</span>
            <h2 class="fw-bold mb-0 text-dark"><%= recetasPendientesCount %></h2>
            <small class="text-warning"><i class="bi bi-clock-history me-1"></i>Por dispensar</small>
          </div>
          <div class="stat-icon bg-warning-subtle text-warning">
            <i class="bi bi-prescription"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-success h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Recetas Entregadas</span>
            <h2 class="fw-bold mb-0 text-dark"><%= recetasEntregadasCount %></h2>
            <small class="text-success"><i class="bi bi-check2-all me-1"></i>Despachadas</small>
          </div>
          <div class="stat-icon bg-success-subtle text-success">
            <i class="bi bi-check-circle-fill"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-danger h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Stock Crítico / Agotado</span>
            <h2 class="fw-bold mb-0 text-dark"><%= medicamentosBajoStock %></h2>
            <small class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Alerta existencias</small>
          </div>
          <div class="stat-icon bg-danger-subtle text-danger">
            <i class="bi bi-box-seam-fill"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-teal h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Total Medicamentos</span>
            <h2 class="fw-bold mb-0 text-dark"><%= totalMedicamentos %></h2>
            <small class="text-teal"><i class="bi bi-boxes me-1"></i>En catálogo</small>
          </div>
          <div class="stat-icon bg-teal-subtle text-teal">
            <i class="bi bi-capsule"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Accesos Rápidos de Farmacia -->
  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <h6 class="fw-bold text-secondary mb-3 text-uppercase fs-8">Operaciones de Farmacia</h6>
          <div class="row g-2">
            <div class="col-12 col-md-4">
              <a href="/farmacia/dispensar" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-check2-circle fs-3 text-primary mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Dispensar Recetas</span>
                <small class="text-muted fs-8">Entrega y rebaja de stock</small>
              </a>
            </div>
            <div class="col-12 col-md-4">
              <a href="/farmacia/inventario" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-boxes fs-3 text-teal mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Inventario y Stock</span>
                <small class="text-muted fs-8">Reabastecer existencias</small>
              </a>
            </div>
            <div class="col-12 col-md-4">
              <a href="/farmacia/movimientos" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-clock-history fs-3 text-secondary mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Auditoría de Movimientos</span>
                <small class="text-muted fs-8">Salidas y reabastecimientos</small>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tablas de Farmacia -->
  <div class="row g-4">
    <!-- Cola de Recetas por Despachar -->
    <div class="col-12 col-lg-7">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-prescription text-teal me-2"></i>Recetas Pendientes de Despacho
          </h5>
          <a href="/farmacia/dispensar" class="btn btn-sm btn-outline-teal">Ver cola completa</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light fs-8 text-uppercase">
                <tr>
                  <th>Código</th>
                  <th>Paciente</th>
                  <th>Fármacos</th>
                  <th class="text-end">Acción</th>
                </tr>
              </thead>
              <tbody>
                <% if (colaRecetas && colaRecetas.length > 0) { %>
                  <% colaRecetas.forEach(function(r) { %>
                    <tr>
                      <td class="fw-bold font-monospace text-teal"><%= r.codigo_receta %></td>
                      <td><%= r.paciente_nombre %> <%= r.paciente_apellido %></td>
                      <td>
                        <span class="badge <%= r.pendientes > 0 ? 'bg-warning text-dark' : 'bg-success' %>">
                          <%= r.pendientes %> pendientes / <%= r.total_items %> total
                        </span>
                      </td>
                      <td class="text-end">
                        <a href="/farmacia/dispensar/<%= r.receta_id %>" class="btn btn-sm btn-teal fw-semibold">
                          <i class="bi bi-check2-circle me-1"></i>Dispensar
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-muted">
                      No hay recetas pendientes en la cola.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Medicamentos con Stock Crítico -->
    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Existencias Críticas
          </h5>
          <a href="/farmacia/inventario" class="btn btn-sm btn-outline-danger">Inventario</a>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <% if (medsCriticos && medsCriticos.length > 0) { %>
              <% medsCriticos.forEach(function(m) { %>
                <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                  <div>
                    <h6 class="mb-0 fw-bold text-dark"><%= m.nombre %></h6>
                    <small class="text-muted"><%= m.presentacion %> &bull; Mínimo: <%= m.stock_minimo %></small>
                  </div>
                  <span class="badge <%= m.stock_actual <= 0 ? 'bg-danger' : 'bg-warning text-dark' %> fs-7">
                    Stock: <%= m.stock_actual %>
                  </span>
                </div>
              <% }); %>
            <% } else { %>
              <div class="text-center py-4 text-muted">
                No hay medicamentos en stock crítico.
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

<% } else { %>
  <!-- ======================================================== -->
  <!-- ⚙️ PANEL EXCLUSIVO PARA ROL ADMINISTRADOR                -->
  <!-- ======================================================== -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">
        <i class="bi bi-shield-shaded text-teal me-2"></i>Panel de Administración y Control Global
      </h1>
      <p class="text-muted mb-0">Gestión de usuarios del sistema, tarifarios pactados con ARS y catálogo de medicamentos.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/usuarios/nuevo" class="btn btn-teal btn-sm fw-semibold shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Crear Nuevo Usuario
      </a>
    </div>
  </div>

  <!-- Métricas del Administrador -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-dark h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Usuarios del Sistema</span>
            <h2 class="fw-bold mb-0 text-dark"><%= totalUsuarios %></h2>
            <small class="text-dark"><i class="bi bi-person-gear me-1"></i>Operadores activos</small>
          </div>
          <div class="stat-icon bg-secondary-subtle text-dark">
            <i class="bi bi-people-fill"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-teal h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Aseguradoras ARS</span>
            <h2 class="fw-bold mb-0 text-dark"><%= totalArs %></h2>
            <small class="text-teal"><i class="bi bi-shield-check me-1"></i>Planes y tarifas</small>
          </div>
          <div class="stat-icon bg-teal-subtle text-teal">
            <i class="bi bi-building-check"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-info h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Catálogo Fármacos</span>
            <h2 class="fw-bold mb-0 text-dark"><%= totalMedicamentos %></h2>
            <small class="text-info"><i class="bi bi-capsule me-1"></i>Medicamentos registrados</small>
          </div>
          <div class="stat-icon bg-info-subtle text-info">
            <i class="bi bi-boxes"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card card-stat border-0 shadow-sm border-start border-4 border-success h-100">
        <div class="card-body d-flex align-items-center justify-content-between p-3">
          <div>
            <span class="text-muted text-uppercase fs-8 fw-semibold">Pacientes y Consultas</span>
            <h2 class="fw-bold mb-0 text-dark"><%= totalPacientes %> / <%= totalConsultas %></h2>
            <small class="text-success"><i class="bi bi-folder-check me-1"></i>Pacientes / Atenciones</small>
          </div>
          <div class="stat-icon bg-success-subtle text-success">
            <i class="bi bi-clipboard2-pulse-fill"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Accesos Administrativos -->
  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <h6 class="fw-bold text-secondary mb-3 text-uppercase fs-8">Gestión Administrativa</h6>
          <div class="row g-2">
            <div class="col-6 col-md-3">
              <a href="/usuarios" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-person-gear fs-3 text-dark mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Usuarios y Roles</span>
                <small class="text-muted fs-8">Control de cuentas</small>
              </a>
            </div>
            <div class="col-6 col-md-3">
              <a href="/ars" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-shield-check fs-3 text-teal mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Tarifarios ARS</span>
                <small class="text-muted fs-8">Configurar coberturas</small>
              </a>
            </div>
            <div class="col-6 col-md-3">
              <a href="/farmacia/inventario" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-capsule fs-3 text-info mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Medicamentos</span>
                <small class="text-muted fs-8">Catálogo farmacia</small>
              </a>
            </div>
            <div class="col-6 col-md-3">
              <a href="/pacientes" class="btn btn-light border w-100 d-flex flex-column align-items-center p-3 text-decoration-none hover-shadow">
                <i class="bi bi-eye fs-3 text-success mb-1"></i>
                <span class="fw-semibold fs-7 text-dark">Supervisión Clínica</span>
                <small class="text-muted fs-8">Directorio y atenciones</small>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tablas Administrativas -->
  <div class="row g-4">
    <!-- Usuarios del Sistema -->
    <div class="col-12 col-lg-7">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-people text-teal me-2"></i>Operadores del Sistema
          </h5>
          <a href="/usuarios" class="btn btn-sm btn-outline-teal">Gestionar usuarios</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light fs-8 text-uppercase">
                <tr>
                  <th>Usuario</th>
                  <th>Nombre</th>
                  <th>Rol</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                <% if (usuariosList && usuariosList.length > 0) { %>
                  <% usuariosList.forEach(function(u) { %>
                    <tr>
                      <td class="fw-bold font-monospace"><%= u.usuario %></td>
                      <td><%= u.nombre %></td>
                      <td>
                        <span class="badge <%= u.rol === 'ADMINISTRADOR' ? 'bg-dark' : (u.rol === 'MEDICO' ? 'bg-success' : (['SECRETARIA', 'RECEPCION'].includes(u.rol) ? 'bg-primary' : 'bg-warning text-dark')) %>">
                          <%= u.rol %>
                        </span>
                      </td>
                      <td>
                        <span class="badge <%= u.activo ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %>">
                          <%= u.activo ? 'Activo' : 'Inactivo' %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- ARS y Tarifarios -->
    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-shield-check text-teal me-2"></i>Tarifarios por ARS
          </h5>
          <a href="/ars" class="btn btn-sm btn-outline-teal">Ver aseguradoras</a>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <% if (arsTarifas && arsTarifas.length > 0) { %>
              <% arsTarifas.forEach(function(a) { %>
                <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                  <div>
                    <h6 class="mb-0 fw-bold text-dark"><%= a.ars_nombre %></h6>
                    <small class="text-muted">Código: <%= a.codigo %></small>
                  </div>
                  <span class="badge bg-teal-subtle text-teal">
                    <%= a.tarifas_configuradas %> tarifa(s)
                  </span>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
